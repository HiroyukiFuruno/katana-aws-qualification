      "requiredChoices": 1,
      "objectiveId": "encryption",
      "sectionId": "encryption",
      "application": "integrate",
      "correct": [
        "A"
      ],
      "choices": [
        {
          "id": "A",
          "text": "分别验证整个路径上的 HTTPS，以及 S3 中对象所应用的 SSE-KMS 和 KMS 密钥。",
          "explanation": "这样可以分别验证通信加密以及存储目标的加密方式和密钥要求。"
        },
        {
          "id": "B",
          "text": "只验证浏览器与订单 API 之间使用 HTTPS。",
          "explanation": "这无法验证从 API 到 S3 的路径，也无法验证静态数据使用指定密钥的要求。"
        },
        {
          "id": "C",
          "text": "由于 S3 默认加密会保护新对象，因此不验证所使用的 KMS 密钥。",
          "explanation": "仅使用默认加密的 SSE-S3 不一定满足组织要求使用指定 KMS 密钥的条件。"
        },
        {
          "id": "D",
          "text": "只验证 S3 对象使用了 SSE-KMS。",
          "explanation": "这无法验证指定的密钥和通信路径上的 HTTPS。"
        }
      ],
      "source": {
        "label": "Amazon S3 默认加密",
        "url": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/default-bucket-encryption.html"
      },
      "learning": {
        "reason": "通信和存储是不同的边界。",
        "concept": "传输中和静态的数据"
      }
    },
