{
  "checkpoints": [
    {
      "id": "fundamentals.cloud-concepts.checkpoint.on-demand.v1",
      "sectionId": "on-demand",
      "objectiveId": "cloud-1",
      "prompt": "会计团队使用的 EC2 计算工作负载在工作日的利用率为 10%，月底为 90%。请选择一种需要考虑的方案，在确保月底处理能力的同时，按运行时长控制成本。",
      "selectionPolarity": "correct",
      "requiredChoices": 1,
      "choices": [
        {
          "id": "A",
          "text": "测量月底的实际使用量，并重新评估平时的计算容量。",
          "explanation": "测量使用量后，可以减少高峰期以外不必要的计算容量。"
        },
        {
          "id": "B",
          "text": "在整个期间固定使用月底高峰时的计算容量。",
          "explanation": "由于即使在低利用率期间也保持峰值容量，因此无法根据使用量进行重新评估。"
        },
        {
          "id": "C",
          "text": "不测量使用量，直接更换为最大的实例。",
          "explanation": "不进行测量就扩大规模，无法区分所需性能和额外成本。"
        },
        {
          "id": "D",
          "text": "为避免成本，即使未使用也始终运行计算资源。",
          "explanation": "始终运行资源会失去根据使用量调整计算资源的优势。"
        }
      ],
      "correct": [
        "A"
      ],
      "source": {
        "label": "AWS：云计算的六大优势",
        "url": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/six-advantages-of-cloud-computing.html"
      },
      "category": "fundamentals.cloud-concepts",
      "revision": 2,
      "title": "在需要时配置，并重新评估所需容量",
      "unitId": "fundamentals.cloud-concepts",
      "version": "2026-11-learning"
    },
    {
      "id": "fundamentals.cloud-concepts.checkpoint.shared-responsibility.v1",
      "sectionId": "shared-responsibility",
      "objectiveId": "cloud-2",
      "prompt": "运维人员发现 EC2 上的应用程序有一个需要更新的依赖库。请选择负责更新该库的正确一方。",
      "selectionPolarity": "correct",
      "requiredChoices": 1,
      "choices": [
        {
          "id": "B",
          "text": "将其作为用户方的操作系统和应用程序更新，制定修复计划。",
          "explanation": "EC2 客户机操作系统以及用户安装的应用程序由用户方负责更新。"
        },
        {
          "id": "A",
          "text": "等待 AWS 更新应用程序的依赖库。",
          "explanation": "依赖库的维护责任不会自动转移给 AWS。"
        },
        {
          "id": "C",
          "text": "因为责任是共享的，所以不确定更新负责人。",
          "explanation": "责任共担并不意味着让负责人变得不明确。"
        },
        {
          "id": "D",
          "text": "要求物理数据中心为应用程序打补丁。",
          "explanation": "保护物理设施与更新 EC2 上的应用程序属于不同层面。"
        }
      ],
      "correct": [
        "B"
      ],
      "source": {
        "label": "AWS：责任共担模型",
        "url": "https://aws.amazon.com/compliance/shared-responsibility-model/"
