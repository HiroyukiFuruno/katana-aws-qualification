{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node --version && bun run check",
  "outputDirectory": "dist",
  "installCommand": "bun install --frozen-lockfile",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:section(study|certifications)/dva-c02/",
      "destination": "/:section/dva-c03/",
      "permanent": true
    },
    {
      "source": "/:locale(ja|zh-CN|zh-TW|ko|pt|fr|de|es|it)/:section(study|certifications)/dva-c02/",
      "destination": "/:locale/:section/dva-c03/",
      "permanent": true
    }
  ]
}
