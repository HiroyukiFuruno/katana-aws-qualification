    {
      "id": "fundamentals.cloud-concepts.checkpoint.regions-az.v1",
      "sectionId": "regions-az",
      "objectiveId": "cloud-3",
      "prompt": "服务负责人希望即使同一可用区中的 EC2 同时停止，服务也能继续运行。请选择一种能够分隔故障影响范围的架构。",
      "selectionPolarity": "correct",
      "requiredChoices": 1,
      "choices": [
        {
          "id": "C",
          "text": "将冗余实例部署到其他 AZ。",
          "explanation": "将实例分散到其他 AZ，可以使其与单个 AZ 共有的故障域隔离。"
        },
        {
          "id": "A",
          "text": "在同一 AZ 中增加更多实例。",
          "explanation": "即使增加实例数量，同一 AZ 的共有故障域仍然存在。"
        },
        {
          "id": "B",
          "text": "增大同一实例的 CPU。",
          "explanation": "更改容量无法隔离 AZ 故障。"
        },
        {
          "id": "D",
          "text": "仅将 Region 名称更改为其他名称。",
          "explanation": "更改名称不会改变实际部署位置或故障域。"
        }
      ],
      "correct": [
        "C"
      ],
      "source": {
        "label": "AWS：区域和可用区",
        "url": "https://docs.aws.amazon.com/global-infrastructure/latest/regions/aws-regions-availability-zones.html"
