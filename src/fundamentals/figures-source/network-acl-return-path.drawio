        <mxCell id="request-label" value="Request: ALB 49152 → EC2 443" style="text;html=0;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#0052CC;" vertex="1" parent="az"><mxGeometry x="155" y="98" width="190" height="24" as="geometry" /></mxCell>
