    {
      "blocks": [
        {
          "contentRef": "section:http-tls:step:2",
          "kind": "steps",
          "label": "步骤 3",
          "text": "仅在 TLS 验证成功后，才调查 HTTP 路径和状态码。",
          "words": 15
        },
        {
          "contentRef": "section:http-tls:outcome",
          "kind": "outcome",
          "label": "结论",
          "text": "不要将证书问题当作 HTTP 404 处理；可以在 TLS 阶段修复该问题。",
          "words": 15
        }
      ],
      "estimatedSeconds": 18,
