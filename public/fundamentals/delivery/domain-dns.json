    {
      "blocks": [
        {
          "contentRef": "section:boundary:misconception:claim",
          "kind": "misconception",
          "label": "これは誤り",
          "text": "証明書エラーはDNSレコードを変えれば必ず直る。",
          "words": 12
        },
        {
          "contentRef": "section:boundary:misconception:correction",
          "kind": "correction",
          "label": "訂正",
          "text": "証明書はTLSの問題です。DNS成功後の段階として確認します。",
