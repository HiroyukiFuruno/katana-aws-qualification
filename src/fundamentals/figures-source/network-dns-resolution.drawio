        <mxCell id="query" value="Query" style="text;html=0;align=center;fontSize=17;fontColor=#24354D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="123" width="74" height="32" />
        </mxCell>
        <mxCell id="answer" value="Answer" style="text;html=0;align=center;fontSize=17;fontColor=#24354D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="258" y="123" width="76" height="32" />
        </mxCell>
        <mxCell id="look" value="Use cached record" style="text;html=0;align=center;fontSize=16;fontColor=#24354D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="81" y="268" width="238" height="25" />
        </mxCell>
        <mxCell id="miss" value="Query on miss" style="text;html=0;align=center;fontSize=16;fontColor=#24354D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3" y="383" width="101" height="29" />
        </mxCell>
        <mxCell id="reply" value="Record reply" style="text;html=0;align=center;fontSize=16;fontColor=#24354D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="299" y="383" width="98" height="29" />
        </mxCell>
        <mxCell id="query-edge" style="endArrow=block;endFill=1;strokeColor=#245892;strokeWidth=2.3;exitX=0.4;exitY=1;entryX=0.41;entryY=0;" edge="1" parent="1" source="client" target="resolver">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="answer-edge" style="endArrow=block;endFill=1;strokeColor=#14736F;strokeWidth=2.3;exitX=0.62;exitY=0;entryX=0.63;entryY=1;" edge="1" parent="1" source="resolver" target="client">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="miss-edge" style="endArrow=block;endFill=1;strokeColor=#245892;strokeWidth=2.3;dashed=1;exitX=0.03;exitY=1;entryX=0.02;entryY=0;" edge="1" parent="1" source="resolver" target="authority">
          <mxGeometry as="geometry" relative="1" />
