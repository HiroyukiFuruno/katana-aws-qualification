    },
    {
      "blocks": [
        {
          "contentRef": "section:artifacts-promotion:scenario",
          "kind": "scenario",
          "label": "情況",
          "text": "我們已在驗證環境中測試訂單 API 的容器映像。現在確認要部署到生產環境的候選映像。"
        },
        {
          "contentRef": "section:artifacts-promotion:step:0",
          "kind": "steps",
          "label": "步驟 1",
          "text": "比對建置結果中的摘要與驗證環境中使用的摘要。"
        },
        {
          "contentRef": "section:artifacts-promotion:step:1",
          "kind": "steps",
          "label": "步驟 2",
          "text": "在生產環境的部署設定中指定相同的摘要，並從生產環境的設定傳入連線目標。"
        }
      ],
      "estimatedSeconds": 26,
      "id": "fundamentals.cicd:section:artifacts-promotion:example:1",
      "kind": "example",
      "label": "具體範例",
