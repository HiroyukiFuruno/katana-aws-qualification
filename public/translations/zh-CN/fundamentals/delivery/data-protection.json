      ],
      "source": {
        "label": "AWS Backup 恢复测试",
        "url": "https://docs.aws.amazon.com/aws-backup/latest/devguide/restore-testing.html"
      },
      "category": "fundamentals.data-protection",
      "revision": 1,
      "title": "备份与恢复：能够创建备份和能够从备份恢复是两回事。",
      "unitId": "fundamentals.data-protection",
      "version": "2026-11-learning"
