    {
      "id": "fundamentals.cloud-concepts.checkpoint.tradeoffs.v1",
      "sectionId": "tradeoffs",
      "objectiveId": "cloud-4",
      "prompt": "有一项处理每月仅高负载 1 小时，并且要求即使一个 AZ 停止也能继续正常处理。请选择两个正确的比较起点。",
      "selectionPolarity": "correct",
      "requiredChoices": 2,
      "choices": [
        {
          "id": "A",
          "text": "比较仅在高负载时段增加所需计算容量的方案。",
          "explanation": "这样可以将负载随时间的变化反映到容量设计中。"
        },
        {
          "id": "B",
          "text": "比较跨 AZ 冗余的成本、剩余容量以及故障隔离的效果。",
          "explanation": "对于 AZ 停止后仍需继续运行的要求，必须评估成本和剩余容量。"
        },
        {
          "id": "C",
          "text": "忽略可用性要求，选择成本最低的单一 AZ。",
          "explanation": "只考虑成本而忽略要求，无法满足必要的持续性。"
        },
        {
          "id": "D",
          "text": "不考虑高负载发生的时间，固定使用最大容量。",
          "explanation": "仅固定在峰值容量，无法评估负载与成本之间的权衡。"
        }
      ],
      "correct": [
        "A",
        "B"
      ],
      "source": {
        "label": "AWS：区域和可用区",
        "url": "https://docs.aws.amazon.com/global-infrastructure/latest/regions/aws-regions-availability-zones.html"
