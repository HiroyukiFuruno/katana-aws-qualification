          "contentRef": "section:recovery:step:2",
          "kind": "steps",
          "label": "步驟 3",
          "text": "將所需時間和結果與 RTO/RPO 比較後記錄。",
          "words": 13
        },
        {
          "contentRef": "section:recovery:outcome",
          "kind": "outcome",
          "label": "結論",
          "text": "可以確認是否能在所需時間內恢復到可用狀態。",
          "words": 15
        }
      ],
      "estimatedSeconds": 18,
