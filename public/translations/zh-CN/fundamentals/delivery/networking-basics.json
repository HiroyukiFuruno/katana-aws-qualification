          "kind": "scenario",
          "label": "情况",
          "text": "浏览器显示 orders.example 的证书名称不匹配，但不显示 HTTP 状态码。",
          "words": 16
        },
        {
          "contentRef": "section:http-tls:step:0",
          "kind": "steps",
          "label": "步骤 1",
          "text": "确认名称解析结果和连接目标是否符合预期。",
          "words": 13
        },
        {
          "contentRef": "section:http-tls:step:1",
          "kind": "steps",
          "label": "步骤 2",
          "text": "检查证书的 SAN/CN、有效期和信任链。",
          "words": 10
        }
      ],
      "estimatedSeconds": 23,
      "id": "fundamentals.networking-basics:section:http-tls:example:1",
