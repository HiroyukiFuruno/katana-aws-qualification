    {
      "blocks": [
        {
          "contentRef": "section:reserved:scenario",
          "kind": "scenario",
          "label": "情境",
          "text": "在一個子網中放置 50 個資源。",
          "words": 10
        },
        {
          "contentRef": "section:reserved:step:0",
          "kind": "steps",
          "label": "步驟 1",
          "text": "在所需的 50 個位址上加上 5 個保留位址。",
          "words": 8
        },
        {
          "contentRef": "section:reserved:step:1",
          "kind": "steps",
          "label": "步驟 2",
          "text": "判斷 /27 子網中的 32 個位址不夠用。",
          "words": 9
