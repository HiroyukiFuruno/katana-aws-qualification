        {
          "contentRef": "section:public:scenario",
          "kind": "scenario",
          "label": "情況",
          "text": "無法從外部透過 HTTPS 連線到名為「public」的子網路中的 EC2 執行個體。"
        },
        {
          "contentRef": "section:public:step:0",
          "kind": "steps",
          "label": "步驟 1",
          "text": "在該子網路的路由表中，確認目的地為 0.0.0.0/0 的路由是否指向 IGW。"
        },
        {
          "contentRef": "section:public:step:1",
          "kind": "steps",
          "label": "步驟 2",
          "text": "確認 EC2 執行個體是否具有公有 IPv4 位址或 Elastic IP。"
        }
      ],
      "estimatedSeconds": 28,
      "id": "fundamentals.cidr-subnets:section:public:example:1",
