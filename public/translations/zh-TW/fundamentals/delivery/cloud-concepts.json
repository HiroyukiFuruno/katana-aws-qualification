        {
          "contentRef": "section:regions-az:step:2",
          "kind": "steps",
          "label": "步驟 3",
          "text": "確認剩餘容量以及相依資料的可達性。",
          "words": 11
        },
        {
          "contentRef": "section:regions-az:outcome",
          "kind": "outcome",
          "label": "結論",
          "text": "評估可用性時，不僅要增加執行個體數量，還要區分故障網域。",
          "words": 13
        }
