%%{init: {'theme': 'base', 'flowchart': {'htmlLabels': true, 'curve': 'linear', 'nodeSpacing': 12, 'rankSpacing': 24}}}%%
flowchart TB
  Cache["09:00 - Resolver A caches<br/>192.0.2.11 for 300 seconds"]
  Change["09:02 - The authoritative A record<br/>changes to 192.0.2.22"]
  SideBySide["09:03 - A still uses its cache<br/>Uncached resolver B gets the new IP"]
  Expire["09:05 - Resolver A's cache expires<br/>Its next lookup gets the new IP"]
  Cache --> Change --> SideBySide --> Expire

  classDef cache fill:#E8F1FB,stroke:#1F5A99,color:#102A43,stroke-width:1.5px;
  classDef change fill:#FFF4E5,stroke:#A65B00,color:#4A2A00,stroke-width:1.5px;
  classDef finish fill:#EAF7EE,stroke:#217346,color:#123524,stroke-width:1.5px;
  class Cache,SideBySide cache;
  class Change change;
  class Expire finish;
