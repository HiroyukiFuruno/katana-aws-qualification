  "guides": {
    "clf-c02": {
      "scope": "涵蓋 AWS 雲端的價值、責任共擔模式、主要服務的用途、定價與支援。",
      "difficulty": 1,
      "why": "重點在於理解基本術語，並知道各項服務適用的情境。",
      "audience": "適合初學 AWS 的人，以及希望在業務規劃或銷售工作中，與開發團隊建立共同雲端認知的人。",
      "path": "cloud-practitioner-02"
    },
    "aif-c01": {
      "scope": "涵蓋 AI、機器學習與生成式 AI 基礎、基礎模型的用途、負責任 AI，以及資料治理。",
      "difficulty": 2,
      "why": "重點是能說明 AI 的用途與風險，而非實作模型。",
      "audience": "適合參與 AI 規劃或業務改善的人，以及剛開始接觸 AI 開發的人。",
      "path": "ai-practitioner-01"
    },
    "saa-c03": {
      "scope": "涵蓋 AWS 架構設計，著重安全性、高可用性，以及效能與成本需求。",
      "difficulty": 3,
      "why": "需要從相似的架構方案中，選出符合可用性、連線路徑與營運負擔等限制的設計。",
      "audience": "適合希望有系統地學習 AWS 架構的基礎架構工程師、SRE 與應用程式開發者。",
      "path": "solutions-architect-associate-03"
    },
    "dva-c03": {
      "scope": "涵蓋 AWS 應用程式開發、AI 輔助開發、身分驗證與授權、測試、部署及故障調查。",
      "difficulty": 3,
      "why": "題目會考查實際執行行為，例如 Lambda 重試與 DynamoDB 條件式更新。",
      "audience": "適合使用 AWS 受管服務建置後端或無伺服器應用程式的開發者。",
      "path": "developer-associate-03"
    },
    "soa-c03": {
      "scope": "涵蓋 AWS 環境監控、可靠性、故障處理、網路與營運自動化。",
      "difficulty": 3,
      "why": "需要根據症狀判斷原因，並選擇符合營運限制的復原或改善方式。",
      "audience": "適合雲端維運人員，以及希望有系統地建立監控和故障應變流程的 SRE。",
      "path": "sysops-administrator-associate-03"
    },
    "dea-c01": {
