        <mxCell id="response" style="endArrow=block;endFill=1;strokeWidth=3;strokeColor=#6554C0;" edge="1" parent="az" source="ec2-sg" target="alb-sg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="301" y="217" /><mxPoint x="199" y="217" /></Array></mxGeometry></mxCell>
        <mxCell id="response-label" value="Response: EC2 443 → ALB 49152" style="text;html=0;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#6554C0;" vertex="1" parent="az"><mxGeometry x="155" y="235" width="190" height="24" as="geometry" /></mxCell>
        <mxCell id="public-rules" value="NACL OUT: destination TCP 443&#10;NACL IN: destination TCP 49152" style="rounded=1;html=0;fillColor=#FFFFFF;strokeColor=#8993A4;fontSize=14;fontColor=#172B4D;" vertex="1" parent="public"><mxGeometry x="14" y="222" width="180" height="51" as="geometry" /></mxCell>
        <mxCell id="private-rules" value="NACL IN: destination TCP 443&#10;NACL OUT: destination TCP 49152" style="rounded=1;html=0;fillColor=#FFFFFF;strokeColor=#8993A4;fontSize=14;fontColor=#172B4D;" vertex="1" parent="private"><mxGeometry x="14" y="222" width="180" height="51" as="geometry" /></mxCell>
        <mxCell id="route-note" value="The local VPC route is assumed; this diagram isolates traffic controls." style="text;html=0;align=center;verticalAlign=middle;fontSize=15;fontColor=#42526E;" vertex="1" parent="vpc"><mxGeometry x="35" y="374" width="462" height="24" as="geometry" /></mxCell>
        <mxCell id="compare" value="How to decide the return path" style="swimlane;html=0;rounded=1;startSize=38;fillColor=#F7FAFC;strokeColor=#4C9AFF;fontSize=21;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="18" y="596" width="564" height="230" as="geometry" /></mxCell>
        <mxCell id="compare-sg" value="Security group (ENI)&#10;&#10;Stateful&#10;Allow: ALB SG → EC2 SG, TCP 443&#10;&#10;Return: established flow allowed&#10;No TCP 49152 return rule." style="rounded=1;html=0;align=left;spacingLeft=16;verticalAlign=top;spacingTop=12;fillColor=#EEF6FF;strokeColor=#2684FF;fontSize=14;fontColor=#172B4D;" vertex="1" parent="compare"><mxGeometry x="18" y="48" width="248" height="152" as="geometry" /></mxCell>
        <mxCell id="compare-nacl" value="Network ACL (subnet)&#10;&#10;Stateless&#10;Request: ALB OUT + EC2 IN, 443&#10;&#10;Return: EC2 OUT + ALB IN, 49152&#10;Allow both directions explicitly." style="rounded=1;html=0;align=left;spacingLeft=16;verticalAlign=top;spacingTop=12;fillColor=#FFF7D6;strokeColor=#FFAB00;fontSize=14;fontColor=#172B4D;" vertex="1" parent="compare"><mxGeometry x="298" y="48" width="248" height="152" as="geometry" /></mxCell>
        <mxCell id="footer" value="Example port: 49152. Allow the required ephemeral range when ports vary." style="text;html=0;align=center;verticalAlign=middle;fontSize=14;fontColor=#42526E;" vertex="1" parent="1"><mxGeometry x="20" y="831" width="560" height="24" as="geometry" /></mxCell>
