  "glossary": [
    {
      "term": "ABAC",
      "expansion": "Attribute-based access control",
      "definition": "通过比对用户和资源标签等属性来控制访问的方式。可将团队标签是否匹配作为条件，避免为每个团队重复编写相同策略。",
      "category": "security",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "ACID",
      "expansion": "Atomicity, consistency, isolation, durability",
      "definition": "事务应具备的原子性、一致性、隔离性和持久性。在需要将多项更新作为整体提交、避免中途失败导致部分更新生效时，这是重要的判断依据。",
      "category": "database",
      "tags": [
        "data-processing"
      ]
    },
    {
      "term": "ACM",
      "expansion": "AWS Certificate Manager",
      "definition": "用于签发和管理 TLS 证书的 AWS 服务。满足验证要求后，关联到支持服务的 AWS 签发证书可由 AWS 托管续订。",
      "category": "security",
      "tags": [
        "encryption"
      ]
    },
    {
      "term": "ALB",
      "expansion": "Application Load Balancer",
      "definition": "处理 HTTP/HTTPS 请求的负载均衡器。适用于按主机名或路径路由请求；与主要转发 TCP/UDP 流量的 NLB 用途不同。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "AMI",
      "expansion": "Amazon Machine Image",
      "definition": "用于启动 EC2 实例的映像，可据此重建包含相同操作系统和已安装软件的实例。",
      "category": "compute",
      "tags": [
        "deployment"
      ]
    },
    {
      "term": "ARN",
      "expansion": "Amazon Resource Name",
      "definition": "用于唯一标识 AWS 资源的名称，常用于指定 IAM 策略的目标。不同服务的 ARN 中，区域或账户字段可能为空。",
      "category": "security",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "ASG",
      "expansion": "Auto Scaling group",
      "definition": "统一管理 EC2 实例数量和运行状况的组，可设置期望容量以及最小和最大容量。",
      "category": "compute",
      "tags": [
        "availability"
      ]
    },
    {
      "term": "AZ",
      "expansion": "Availability Zone",
      "definition": "AWS 区域内彼此隔离的位置。为应对单个可用区故障，应考虑让计算和数据跨多个可用区部署。",
      "category": "architecture",
      "tags": [
        "availability"
      ]
    },
    {
      "term": "Batch inference",
      "expansion": "",
      "definition": "将多个输入集中进行异步推理的方式。适合不要求立即返回结果的大批量处理，可与持续运行的实时推理对比选择。",
      "category": "ai",
      "tags": [
        "machine-learning"
      ]
    },
    {
      "term": "BGP",
      "expansion": "Border Gateway Protocol",
      "definition": "在网络之间交换可达路由的协议，常与支持动态路由的 Direct Connect 或站点到站点 VPN 配合使用。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "Blue/green deployment",
      "expansion": "",
      "definition": "让旧环境与新环境并行运行，验证新环境后再将流量切换过去。如果数据变更仍兼容旧环境，回滚就比较容易。",
      "category": "architecture",
      "tags": [
        "deployment"
      ]
    },
    {
      "term": "Canary deployment",
      "expansion": "",
      "definition": "先将少量流量导向新版本，确认错误率等指标正常后再逐步扩大发布范围。这样可以在出现异常时限制影响。",
      "category": "architecture",
      "tags": [
        "deployment"
      ]
    },
    {
      "term": "CDC",
      "expansion": "Change data capture",
      "definition": "捕获新增、更新、删除等数据变更，并持续同步到其他系统。数据库迁移通常将其与首次全量加载结合使用，切换前还要检查同步延迟。",
      "category": "database",
      "tags": [
        "data-processing"
      ]
    },
    {
      "term": "CIDR",
      "expansion": "Classless Inter-Domain Routing",
      "definition": "用前缀表示网络地址范围的方法，例如10.0.0.0/16。设计VPC互联时，需要注意地址范围重叠对路由选择的影响。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "CMK",
      "expansion": "Customer master key",
      "definition": "AWS KMS过去使用的术语。现在统称为KMS key，其中由用户创建并管理密钥策略的密钥称为customer managed key。",
      "category": "security",
      "tags": [
        "encryption"
      ]
    },
    {
      "term": "CORS",
      "expansion": "Cross-origin resource sharing",
      "definition": "服务器通过HTTP响应头，声明浏览器在什么条件下可以访问其他来源的资源。资源本身的身份验证与授权仍需单独实施。",
      "category": "networking",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "CUR",
      "expansion": "AWS Cost and Usage Reports",
      "definition": "用于查看AWS费用和使用量明细的报告。按账户或服务分析时，还需检查汇总设置以及相关标签是否已启用。",
      "category": "management",
      "tags": [
        "cost"
      ]
    },
    {
      "term": "DLQ",
      "expansion": "Dead-letter queue",
      "definition": "用于隔离处理失败或投递失败消息的队列。设计时需要明确收集哪个处理阶段的失败消息，以及重新处理前如何消除故障原因。",
      "category": "integration",
      "tags": [
        "event-driven"
      ]
    },
    {
      "term": "DR",
      "expansion": "Disaster recovery",
      "definition": "灾难发生后恢复服务和数据的设计与操作流程。需要确定RPO和RTO，并验证实际的故障切换与回切过程。",
      "category": "architecture",
      "tags": [
        "disaster-recovery"
      ]
    },
    {
      "term": "DynamoDB Streams",
      "expansion": "",
      "definition": "按时间顺序记录DynamoDB表项目变更的功能。可以据此触发后续处理；为应对同一处理被重复执行，处理逻辑需要具备幂等性。",
      "category": "database",
      "tags": [
        "event-driven",
        "data-processing"
      ]
    },
    {
      "term": "EBS",
      "expansion": "Amazon Elastic Block Store",
      "definition": "供EC2等使用的块存储。卷属于特定AZ，可以通过快照在另一个AZ创建新卷。",
      "category": "storage",
      "tags": [
        "data-protection"
      ]
    },
    {
      "term": "ECS",
      "expansion": "Amazon Elastic Container Service",
      "definition": "负责管理容器运行并维持服务状态的AWS编排服务。可以使用EC2或AWS Fargate等作为运行基础设施。",
      "category": "compute",
      "tags": [
        "containers"
      ]
    },
    {
      "term": "EKS",
      "expansion": "Amazon Elastic Kubernetes Service",
      "definition": "在AWS上运行Kubernetes的托管服务。需要保留Kubernetes API和现有运维工具、配置时，可以考虑使用。",
      "category": "compute",
      "tags": [
        "containers"
      ]
    },
    {
      "term": "ENI",
      "expansion": "Elastic network interface",
      "definition": "VPC中的虚拟网络接口，属于特定子网。将接口转接到另一台EC2时，需要使用辅助ENI，并满足位于同一AZ等条件。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "ETL",
      "expansion": "Extract, transform, load",
      "definition": "先提取源数据，再进行转换，最后加载到目标存储的处理流程。它与加载后才转换数据的ELT在处理顺序上不同。",
      "category": "analytics",
      "tags": [
        "data-processing"
      ]
    },
    {
      "term": "Fan-out",
      "expansion": "",
      "definition": "将一个事件分别发送给多个订阅方的架构。如果希望各消费者独立控制处理速度和重试，可以考虑为每个订阅方配置独立队列。",
      "category": "integration",
      "tags": [
        "event-driven"
      ]
    },
    {
      "term": "Guardrail",
      "expansion": "",
      "definition": "用于将设计和运维限制在允许范围内的管控措施。AWS Control Tower现在将其称为control，包括预防操作、检测违规和创建前检查等类型。",
      "category": "management",
      "tags": [
        "governance"
      ]
    },
    {
      "term": "IAM",
      "expansion": "AWS Identity and Access Management",
      "definition": "控制AWS资源访问权限的机制。判断某项操作是否被允许时，需要结合身份策略、资源策略以及适用的权限上限。",
      "category": "security",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "Idempotency",
      "expansion": "",
      "definition": "重复提交含义相同的请求，结果及副作用仍与只执行一次相同的特性。它是安全重试订单、支付等操作的关键。",
      "category": "architecture",
      "tags": [
        "event-driven"
      ]
    },
    {
      "term": "IGW",
      "expansion": "Internet gateway",
      "definition": "连接VPC与互联网的网关。EC2要通过IPv4直接与互联网通信，需要公有IPv4地址、相应路由以及允许通信的配置。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "IRSA",
      "expansion": "IAM roles for service accounts",
      "definition": "在EKS中将Kubernetes服务账户与IAM角色关联的机制。应收紧OIDC信任条件，仅为目标工作负载授予所需权限。",
      "category": "security",
      "tags": [
        "access-control",
        "containers"
      ]
    },
    {
      "term": "KMS",
      "expansion": "AWS Key Management Service",
      "definition": "用于创建和管理加密密钥、控制加密操作的AWS服务。跨账户使用时，应检查密钥策略、调用方权限及目标服务的限制。",
      "category": "security",
      "tags": [
        "encryption"
      ]
    },
    {
      "term": "Least privilege",
      "expansion": "",
      "definition": "只向身份授予完成工作所必需权限的原则。应限定允许执行的操作、可访问的资源以及使用条件。",
      "category": "security",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "NACL",
      "expansion": "Network access control list",
      "definition": "在子网边界控制流量的规则。由于它是无状态的，所需通信的请求方向和返回方向都必须放行。",
      "category": "networking",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "NAT",
      "expansion": "Network address translation",
      "definition": "转换数据包IP地址等信息的机制。公有NAT Gateway可用于由私有子网主动发起的IPv4互联网通信等场景。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "NLB",
      "expansion": "Network Load Balancer",
      "definition": "处理TCP、UDP、TLS等流量的负载均衡器。适用于需要每个AZ具有固定IP地址等场景；基于HTTP路径的转发属于ALB的功能。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "OAC",
      "expansion": "Origin access control",
      "definition": "CloudFront向S3等受支持源站发送请求时使用的身份验证机制。可以关闭用户直接访问源站的通道，将内容分发限制为经由CloudFront进行。",
      "category": "security",
      "tags": [
        "data-protection"
      ]
    },
    {
      "term": "OIDC",
      "expansion": "OpenID Connect",
      "definition": "建立在OAuth 2.0之上的身份验证规范。与AWS集成时，可以验证OIDC提供商所签发令牌的相关条件，获取临时AWS凭证。",
      "category": "security",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "OU",
      "expansion": "Organizational unit",
      "definition": "在AWS Organizations中按层级组织账户的单位。附加到OU的SCP也适用于其下的成员账户，但加入OU本身不会授予IAM权限。",
      "category": "management",
      "tags": [
        "governance"
      ]
    },
    {
      "term": "Pilot light",
      "expansion": "",
      "definition": "仅在灾难恢复环境中保留数据和核心组件，发生灾难后再启动完整服务的方式。相比维持可立即运行的缩小版环境的温备方式，通常需要更多恢复步骤。",
      "category": "architecture",
      "tags": [
        "disaster-recovery"
      ]
    },
    {
      "term": "PITR",
      "expansion": "Point-in-time recovery",
      "definition": "将数据恢复到保留期内某个指定时间点的功能。应确认各服务的保留期、最近可恢复的时间，以及恢复时是否会创建新资源。",
      "category": "database",
      "tags": [
        "data-protection",
        "disaster-recovery"
      ]
    },
    {
      "term": "PrivateLink",
      "expansion": "AWS PrivateLink",
      "definition": "无需经过互联网即可私有访问服务的机制。不必让两个VPC全面互通，某些架构还支持连接CIDR重叠的VPC。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "RAG",
      "expansion": "Retrieval-augmented generation",
      "definition": "先检索相关文档，再将检索结果加入模型输入以生成回答的方式。评估时应区分未检索到所需内容的问题，以及生成环节未能利用检索内容的问题。",
      "category": "ai",
      "tags": [
        "generative-ai",
        "data-processing"
      ]
    },
    {
      "term": "RCP",
      "expansion": "Resource control policy",
      "definition": "在AWS Organizations中，为受支持资源可获得的权限设置上限的策略。它与限定身份权限上限的SCP作用不同，应结合控制对象选用。",
      "category": "security",
      "tags": [
        "governance"
      ]
    },
    {
      "term": "RPO",
      "expansion": "Recovery point objective",
      "definition": "以时间表示恢复时可容忍的数据丢失范围的目标。例如RPO为5分钟，意味着最多可接受丢失故障发生前5分钟内的数据。",
      "category": "architecture",
      "tags": [
        "disaster-recovery"
      ]
    },
    {
      "term": "RTO",
      "expansion": "Recovery time objective",
      "definition": "从发生故障到恢复服务所允许的目标时间。不仅要计算数据恢复时间，还应包括重启、DNS切换和健康检查所需时间。",
      "category": "architecture",
      "tags": [
        "disaster-recovery"
      ]
    },
    {
      "term": "SCP",
      "expansion": "Service control policy",
      "definition": "在AWS Organizations中，限制成员账户内IAM身份可获得权限上限的策略。要实际允许访问，仍需IAM等策略授予相应权限。",
      "category": "security",
      "tags": [
        "governance"
      ]
    },
    {
      "term": "Security group",
      "expansion": "",
      "definition": "通过允许规则控制VPC资源通信的机制。它具有状态跟踪能力，已获准通信的响应流量无需另设允许规则。",
      "category": "networking",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "SLO",
      "expansion": "Service level objective",
      "definition": "对用户所获服务质量设定的目标值。例如将月度正常响应率定为99.9%，并明确实际测量的指标和统计范围。",
      "category": "architecture",
      "tags": [
        "observability",
        "availability"
      ]
    },
    {
      "term": "SSE-KMS",
      "expansion": "Server-side encryption with AWS KMS keys",
      "definition": "由服务端加密S3等服务中存储的数据，并使用AWS KMS管理密钥的方式。除了对象操作权限，还需要相应的KMS权限。",
      "category": "storage",
      "tags": [
        "data-protection",
        "encryption"
      ]
    },
    {
      "term": "STS",
      "expansion": "AWS Security Token Service",
      "definition": "签发访问AWS所需临时凭证的服务。代入角色时，应检查角色的信任条件和调用方权限。",
      "category": "security",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "TGW",
      "expansion": "AWS Transit Gateway",
      "definition": "Transit Gateway（TGW）可作为网络枢纽连接多个 VPC 和本地网络。设计时需要为每个连接配置路由表关联和路由传播。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "TTL",
      "expansion": "Time to live",
      "definition": "TTL 是数据或缓存保持有效的时长。在 DNS 中，它决定缓存时间；在 DynamoDB 中，TTL 可用于自动删除过期项目。",
      "category": "database",
      "tags": [
        "data-processing"
      ]
    },
    {
      "term": "VPC",
      "expansion": "Virtual private cloud",
      "definition": "VPC 是 AWS 中逻辑隔离的网络。可在其中规划 IP 地址范围、子网、路由和连接目标，并设计公有与私有通信路径。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "VPC endpoint",
      "expansion": "",
      "definition": "VPC endpoint 让 VPC 无需经过互联网即可访问服务。接口型端点通过 ENI 和 DNS 连接；网关型端点则通过路由表将流量发送到相应服务。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "WAF",
      "expansion": "Web application firewall",
      "definition": "WAF 根据规则允许、拦截或统计 HTTP 请求。AWS WAF 可关联 CloudFront、ALB 等受支持的服务。",
      "category": "security",
      "tags": [
        "data-protection"
      ]
    },
    {
      "term": "Warm standby",
      "expansion": "",
      "definition": "Warm standby 会让灾备环境中可正常工作的精简版系统持续运行，发生故障时再扩展容量。选择方案时，可结合成本和切换时间与 Pilot light 比较。",
      "category": "architecture",
      "tags": [
        "disaster-recovery"
      ]
    },
    {
      "term": "EC2",
      "expansion": "Amazon Elastic Compute Cloud",
      "definition": "EC2 可按需启动虚拟服务器。需要自行管理操作系统和运行环境时可使用 EC2，也可通过 AMI 创建配置一致的实例。",
      "category": "compute",
      "tags": [
        "availability"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/compute-services.html"
    },
    {
      "term": "Lambda",
      "expansion": "AWS Lambda",
      "definition": "Lambda 可由事件触发代码运行，服务器基础设施由 AWS 管理。例如，可在对象写入 S3 或消息进入 SQS 时启动处理。",
      "category": "compute",
      "tags": [
        "serverless",
        "event-driven"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/compute-services.html"
    },
    {
      "term": "S3",
      "expansion": "Amazon Simple Storage Service",
      "definition": "S3 将对象存放在存储桶中。与用于共享文件的 EFS、按块存取的 EBS 不同，S3 对象通过 API 读写。",
      "category": "storage",
      "tags": [
        "data-protection"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/storage-services.html"
    },
    {
      "term": "EFS",
      "expansion": "Amazon Elastic File System",
      "definition": "EFS 是可供多个计算环境共享的 NFS 文件存储，常用于 Linux 应用共享文件的读写。",
      "category": "storage",
      "tags": [
        "availability"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/storage-services.html"
    },
    {
      "term": "FSx",
      "expansion": "Amazon FSx",
      "definition": "FSx 提供由 AWS 管理的文件系统，例如 Windows File Server 和 Lustre。应根据应用需要的协议和功能选择合适的类型。",
      "category": "storage",
      "tags": [
        "availability"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/storage-services.html"
    },
    {
      "term": "RDS",
      "expansion": "Amazon Relational Database Service",
      "definition": "RDS 可代管关系型数据库的设置、备份等工作。需要 SQL 和事务处理时，可将它与 DynamoDB 等非关系型数据库比较。",
      "category": "database",
      "tags": [
        "data-protection",
        "availability"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/database.html"
    },
    {
      "term": "Aurora",
      "expansion": "Amazon Aurora",
      "definition": "Aurora 是兼容 MySQL 和 PostgreSQL 的关系型数据库。其计算与存储分离的架构，可作为提升可用性或扩展读取能力的选项。",
      "category": "database",
      "tags": [
        "availability"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/database.html"
    },
    {
      "term": "DynamoDB",
      "expansion": "Amazon DynamoDB",
      "definition": "DynamoDB 是无服务器数据库，可存储键值数据和文档。访问模式（例如分区键）的设计很重要；它不以支持任意关联查询为前提。",
      "category": "database",
      "tags": [
        "serverless",
        "data-processing"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/database.html"
    },
    {
      "term": "ElastiCache",
      "expansion": "Amazon ElastiCache",
      "definition": "ElastiCache 用于管理内存缓存。将频繁读取的数据放入缓存，可减轻数据库负载并缩短响应时间。",
      "category": "database",
      "tags": [
        "data-processing"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/database.html"
    },
    {
      "term": "CloudFront",
      "expansion": "Amazon CloudFront",
      "definition": "CloudFront 是从边缘站点分发内容的 CDN。将缓存部署在靠近用户的位置，可减轻源站负载并降低分发延迟。",
      "category": "networking",
      "tags": [
        "connectivity"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/networking-services.html"
    },
    {
      "term": "Route 53",
      "expansion": "Amazon Route 53",
      "definition": "Route 53 提供 DNS 解析、域名注册和运行状况检查。它可将域名映射到目标，并通过路由策略控制 DNS 响应指向哪里。",
      "category": "networking",
      "tags": [
        "connectivity",
        "availability"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/networking-services.html"
    },
    {
      "term": "API Gateway",
      "expansion": "Amazon API Gateway",
      "definition": "API Gateway 用于发布和管理 API。可配置身份验证和限流，并将请求转发到 Lambda 等后端。",
      "category": "networking",
      "tags": [
        "serverless",
        "access-control"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/networking-services.html"
    },
    {
      "term": "EventBridge",
      "expansion": "Amazon EventBridge",
      "definition": "EventBridge 接收来自服务和应用程序的事件，再按规则将事件发送到目标。它适合在架构中解耦事件来源与后续处理。",
      "category": "integration",
      "tags": [
        "event-driven",
        "serverless"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/application-integration.html"
    },
    {
      "term": "SNS",
      "expansion": "Amazon Simple Notification Service",
      "definition": "SNS 可将消息发布给订阅主题的多个目标。采用扇出架构时，同一事件可以发送到多个 SQS 队列。",
      "category": "integration",
      "tags": [
        "event-driven",
        "serverless"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/application-integration.html"
    },
    {
      "term": "SQS",
      "expansion": "Amazon Simple Queue Service",
      "definition": "SQS 将消息暂存在队列中，由消费者取出处理。队列可解耦发送方和接收方、缓冲负载波动；还应考虑用幂等处理应对重复投递。",
      "category": "integration",
      "tags": [
        "event-driven",
        "serverless"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/application-integration.html"
    },
    {
      "term": "Step Functions",
      "expansion": "AWS Step Functions",
      "definition": "Step Functions 以状态机编排多个处理步骤。可定义分支、并行执行和重试等流程，并协调 Lambda 等服务完成工作。",
      "category": "integration",
      "tags": [
        "serverless",
        "event-driven"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/application-integration.html"
    },
    {
      "term": "CloudWatch",
      "expansion": "Amazon CloudWatch",
      "definition": "CloudWatch 收集指标和日志等数据来监控系统。可通过告警发现异常，并触发相应的运维处理。",
      "category": "management",
      "tags": [
        "observability"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/management-governance.html"
    },
    {
      "term": "CloudTrail",
      "expansion": "AWS CloudTrail",
      "definition": "CloudTrail 将 AWS 上用户和服务执行的操作记录为事件。调查是谁调用了哪个 API 时可查阅 CloudTrail；它与用于性能监控的 CloudWatch 职责不同。",
      "category": "management",
      "tags": [
        "observability",
        "governance"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/management-governance.html"
    },
    {
      "term": "Config",
      "expansion": "AWS Config",
      "definition": "AWS Config 记录 AWS 资源的配置及变更历史。它可评估资源是否符合规则，并帮助调查非预期的配置变更。",
      "category": "management",
      "tags": [
        "governance"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/management-governance.html"
    },
    {
      "term": "CloudFormation",
      "expansion": "AWS CloudFormation",
      "definition": "CloudFormation 通过模板定义 AWS 资源，并以堆栈为单位创建或更新资源。基础设施可作为代码管理，减少手动操作造成的差异。",
      "category": "management",
      "tags": [
        "deployment"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/management-governance.html"
    },
    {
      "term": "Organizations",
      "expansion": "AWS Organizations",
      "definition": "AWS Organizations 集中管理多个 AWS 账户。可用 OU 整理账户，并通过 SCP 等策略实施组织级治理。",
      "category": "management",
      "tags": [
        "governance"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/management-governance.html"
    },
    {
      "term": "Control Tower",
      "expansion": "AWS Control Tower",
      "definition": "AWS Control Tower 用于设置和治理多账户 AWS 环境。它通过 Landing Zone 和 Controls 协助建立统一的账户管理方式。",
      "category": "management",
      "tags": [
        "governance"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/management-governance.html"
    },
    {
      "term": "Secrets Manager",
      "expansion": "AWS Secrets Manager",
      "definition": "Secrets Manager 用于保存密码、API 密钥等机密信息。配置相应集成后可自动轮换凭证，也能避免将凭证写入代码。",
      "category": "security",
      "tags": [
        "access-control",
        "encryption"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/security-services.html"
    },
    {
      "term": "Cognito",
      "expansion": "Amazon Cognito",
      "definition": "Cognito 提供应用程序用户的注册和登录等功能。它面向应用用户；IAM Identity Center 则用于管理员工对 AWS 账户和应用程序的访问。",
      "category": "security",
      "tags": [
        "access-control"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/security-services.html"
    },
    {
      "term": "Shield",
      "expansion": "AWS Shield",
      "definition": "Shield 用于保护应用程序免受 DDoS 攻击。它与检查 HTTP 请求内容的 WAF 职责不同，两者可以搭配使用。",
      "category": "security",
      "tags": [
        "data-protection"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/security-services.html"
    },
    {
      "term": "Macie",
      "expansion": "Amazon Macie",
      "definition": "Macie 可协助发现 S3 中的敏感数据，帮助了解个人信息等数据的存储情况，并支持后续调查和保护措施。",
      "category": "security",
      "tags": [
        "data-protection",
        "governance"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/security-services.html"
    },
    {
      "term": "GuardDuty",
      "expansion": "Amazon GuardDuty",
      "definition": "GuardDuty 分析日志和事件等数据以检测威胁。它会报告可疑访问等发现，为安全调查提供线索。",
      "category": "security",
      "tags": [
        "observability",
        "data-protection"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/security-services.html"
    },
    {
      "term": "Security Hub CSPM",
      "expansion": "AWS Security Hub Cloud Security Posture Management",
      "definition": "Security Hub CSPM 按安全标准评估 AWS 环境并汇总发现。它可持续检查资源配置问题和合规状况。",
      "category": "security",
      "tags": [
        "governance",
        "observability"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/security-services.html"
    },
    {
      "term": "IAM Identity Center",
      "expansion": "AWS IAM Identity Center",
      "definition": "IAM Identity Center 集中管理员工访问多个 AWS 账户和应用程序所需的身份验证与权限。通过权限集为用户或组分配账户访问权限。",
      "category": "security",
      "tags": [
        "access-control",
        "governance"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/security-services.html"
    },
    {
      "term": "Savings Plans",
      "expansion": "",
      "definition": "Savings Plans 是一种定价方案：承诺一段时间内每小时达到一定消费额，即可为符合条件的计算用量享受折扣。适用范围取决于方案类型；它与容量预留是两回事。",
      "category": "compute",
      "tags": [
        "cost"
      ],
      "source": "https://docs.aws.amazon.com/savingsplans/latest/userguide/what-is-savings-plans.html"
    },
    {
      "term": "Reserved Instances",
      "expansion": "",
      "definition": "Reserved Instances 通过承诺 EC2 等服务在特定条件下使用一段时间来获得费用折扣。在 EC2 中，是否包含容量预留取决于范围等设置，例如区域或可用区。",
      "category": "compute",
      "tags": [
        "cost"
      ],
      "source": "https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/ec2-reserved-instances.html"
    },
    {
      "term": "Spot Instances",
      "expansion": "",
      "definition": "Spot Instances 以折扣价格使用 EC2 的闲置容量。由于容量可能被回收，适合考虑用于可重试的批处理或分布式任务。",
      "category": "compute",
      "tags": [
        "cost",
        "availability"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/compute-services.html"
    },
    {
      "term": "Bedrock",
      "expansion": "Amazon Bedrock",
      "definition": "Amazon Bedrock 是用于构建生成式 AI 应用程序的托管服务，可调用基础模型，也可搭配 RAG 和 Bedrock Guardrails 等功能。",
      "category": "ai",
      "tags": [
        "generative-ai",
        "serverless"
      ],
      "source": "https://docs.aws.amazon.com/bedrock/latest/userguide/what-is-bedrock.html"
    },
    {
      "term": "SageMaker AI",
      "expansion": "Amazon SageMaker AI",
      "definition": "SageMaker AI 支持机器学习模型的构建、训练和部署，也涵盖使用自有数据训练模型并通过推理端点提供服务等流程。",
      "category": "ai",
      "tags": [
        "machine-learning"
      ],
      "source": "https://docs.aws.amazon.com/sagemaker/latest/dg/whatis.html"
    },
    {
      "term": "Token",
      "expansion": "",
      "definition": "Token 是生成式 AI 模型处理文本时使用的单位。文本会拆分为词语、词语片段或符号；同一句话的 Token 数量会因模型和语言而异。",
      "category": "ai",
      "tags": [
        "generative-ai"
      ],
      "source": "https://docs.aws.amazon.com/bedrock/latest/userguide/key-definitions.html"
    },
    {
      "term": "Embedding",
      "expansion": "",
      "definition": "Embedding 将文本等内容的含义或特征表示为数值向量。通过比较向量的相似度来检索相关信息，常用于 RAG 的检索环节。",
      "category": "ai",
      "tags": [
        "generative-ai",
        "data-processing"
      ],
      "source": "https://docs.aws.amazon.com/bedrock/latest/userguide/key-definitions.html"
    },
    {
      "term": "Fine-tuning",
      "expansion": "",
      "definition": "Fine-tuning 是使用额外的训练数据调整已有模型的方法。它会更新模型权重，使模型适应特定任务或回答格式；这与检索外部信息的 RAG 在目的和机制上不同。",
      "category": "ai",
      "tags": [
        "generative-ai",
        "machine-learning"
      ],
      "source": "https://docs.aws.amazon.com/bedrock/latest/userguide/key-definitions.html"
    },
    {
      "term": "Hallucination",
      "expansion": "",
      "definition": "Hallucination（幻觉）是生成式 AI 将缺乏依据或与事实不符的内容，以看似可信的方式输出的现象。RAG 提供依据也无法彻底避免幻觉，因此仍需核对来源并进行评估。",
      "category": "ai",
      "tags": [
        "generative-ai",
        "data-protection"
      ],
      "source": "https://docs.aws.amazon.com/bedrock/latest/userguide/guardrails-contextual-grounding-check.html"
    },
    {
      "term": "Prompt injection",
      "expansion": "",
      "definition": "Prompt injection（提示注入）是将恶意指令藏在用户输入或检索到的文档中，试图诱使生成式 AI 偏离原有指令的攻击。设计时应避免把外部内容当作指令执行。",
      "category": "ai",
      "tags": [
        "generative-ai",
        "data-protection"
      ],
      "source": "https://docs.aws.amazon.com/bedrock/latest/userguide/guardrails-prompt-attack.html"
    },
    {
      "term": "Vector database",
      "expansion": "",
      "definition": "Vector database（向量数据库）存储 Embedding 等向量，并按相似度检索数据。它适合查找语义相近、难以仅靠关键词完全匹配找到的信息。",
      "category": "database",
      "tags": [
        "generative-ai",
        "data-processing"
      ],
      "source": "https://docs.aws.amazon.com/bedrock/latest/userguide/knowledge-base.html"
    },
    {
      "term": "Lake Formation",
      "expansion": "AWS Lake Formation",
      "definition": "Lake Formation 协助构建数据湖并管理访问权限。它可与数据目录配合，细致管理表等数据资源的访问权限。",
      "category": "analytics",
      "tags": [
        "data-processing",
        "access-control"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/analytics.html"
    },
    {
      "term": "Glue",
      "expansion": "AWS Glue",
      "definition": "Glue 是用于发现、编目和转换数据的数据集成服务。通过 ETL 作业，可将多个数据源整理成便于分析的格式。",
      "category": "analytics",
      "tags": [
        "data-processing",
        "serverless"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/analytics.html"
    },
    {
      "term": "Kinesis Data Streams",
      "expansion": "Amazon Kinesis Data Streams",
      "definition": "Kinesis Data Streams 可持续接收数据流，并让多个应用程序分别处理这些数据，适合低延迟处理日志和事件等数据。",
      "category": "analytics",
      "tags": [
        "data-processing",
        "event-driven"
      ],
      "source": "https://docs.aws.amazon.com/whitepapers/latest/aws-overview/analytics.html"
    },
    {
      "term": "Bedrock Guardrails",
      "expansion": "Amazon Bedrock Guardrails",
      "definition": "Bedrock Guardrails 可评估生成式 AI 的输入和模型响应，检测并控制有害内容或敏感信息等。它还能设定业务不允许涉及的主题及信息保护规则，职责不同于 Control Tower 的治理控制。",
      "category": "ai",
      "tags": [
        "generative-ai",
        "data-protection"
      ],
      "source": "https://docs.aws.amazon.com/bedrock/latest/userguide/guardrails.html"
    }
  ],
