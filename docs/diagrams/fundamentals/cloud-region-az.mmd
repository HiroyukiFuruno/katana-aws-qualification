%%{init: {'theme': 'base', 'flowchart': {'htmlLabels': true, 'curve': 'linear'}}}%%
flowchart TB
  Traffic[Client traffic]
  subgraph Region[AWS Region]
    direction TB
    AZA[Availability Zone A<br/>App copy]
    Failure[Failure affects<br/>Zone A only]
    AZB[Availability Zone B<br/>Separate app copy]
    Available[App copy remains<br/>available]
  end

  Traffic --> AZA
  AZA --> Failure
  Failure -.separate failure scope.-> AZB --> Available

  classDef stage fill:#E8F1FB,stroke:#1F5A99,color:#102A43,stroke-width:1.5px;
  classDef risk fill:#FCE8E6,stroke:#B3261E,color:#5F1111,stroke-width:1.5px;
  classDef good fill:#E6F4EA,stroke:#137333,color:#0D3B1E,stroke-width:1.5px;
  class Traffic,AZA,AZB stage;
  class Failure risk;
  class Available good;
