  "guides": {
    "clf-c02": {
      "scope": "考查对 AWS 云价值、责任共担模型、主要服务作用、定价和支持的理解。",
      "difficulty": 1,
      "why": "重点是基本术语，以及根据场景选择合适的服务。",
      "audience": "适合初学 AWS 的人员，以及希望在销售、规划等工作中与开发团队统一云基础认知的人员。",
      "path": "cloud-practitioner-02"
    },
    "aif-c01": {
      "scope": "涵盖人工智能、机器学习和生成式人工智能的基础知识、基础模型的使用、负责任的人工智能和数据治理。",
      "difficulty": 2,
      "why": "能够解释用途和风险比实现模型更重要。",
      "audience": "参与利用人工智能进行规划和业务改进的人，以及已经开始学习人工智能开发的人。",
      "path": "ai-practitioner-01"
    },
    "saa-c03": {
      "scope": "涵盖安全、高可用并满足性能和成本要求的 AWS 架构的设计。",
      "difficulty": 3,
      "why": "从类似的架构方案中，选择满足可用性、连接路径和运维负担等约束的方案。",
      "audience": "想要系统学习 AWS 设计的基础设施工程师、SRE 和应用程序开发人员。",
      "path": "solutions-architect-associate-03"
    },
    "dva-c03": {
      "scope": "涵盖 AWS 上的应用开发、AI 辅助开发、身份验证与授权、测试、部署和故障排查。",
      "difficulty": 3,
      "why": "考查 Lambda 重试、DynamoDB 条件更新等实现层面的行为。",
      "audience": "使用 AWS 托管服务创建后端和无服务器应用程序的开发人员。",
      "path": "developer-associate-03"
    },
    "soa-c03": {
      "scope": "涵盖 AWS 环境的监控、可靠性、故障响应、网络和运维自动化。",
      "difficulty": 3,
      "why": "需要从症状定位原因，并选择符合运维约束的恢复和改进方案。",
      "audience": "想要系统化监控和故障响应的云运维人员和 SRE。",
      "path": "sysops-administrator-associate-03"
    },
    "dea-c01": {
      "scope": "涵盖数据摄取、转换、存储、管道运维和访问管理。",
      "difficulty": 3,
      "why": "需要理解不同处理方式在延迟、重试、成本和访问控制方面的差异。",
      "audience": "参与构建和运营 ETL、数据湖和分析平台的人员。",
      "path": "data-engineer-associate-01"
    },
    "mla-c01": {
      "scope": "涵盖训练数据准备、模型开发、部署，以及模型和基础设施监控。",
      "difficulty": 4,
      "why": "同时考查机器学习评估指标，以及在 AWS 上部署和运维模型的能力。",
      "audience": "想要将经过训练的模型投入生产并持续管理质量和成本的 ML 工程师。",
      "path": "machine-learning-engineer-associate-01"
    },
    "sap-c03": {
      "scope": "涵盖跨组织云架构、安全与治理、成本、迁移与业务连续性，以及运维自动化；也包括集成 AI/ML 的设计。",
      "difficulty": 5,
      "why": "在多账户和既有系统约束交织时，需同时评估运维、成本和恢复要求。",
      "audience": "审核多个团队设计的架构师，负责云迁移和标准化的技术主管。",
      "path": "solutions-architect-professional-03"
    },
    "dop-c02": {
      "scope": "涵盖 CI/CD、配置管理、监控、事件响应，以及安全性和可用性的自动化。",
      "difficulty": 5,
      "why": "需要能够设计从多环境部署到异常检测后回滚的一整套运维流程。",
      "audience": "适合负责多团队发布平台或云运维自动化的 DevOps 工程师和 SRE。",
      "path": "devops-engineer-professional-02"
    },
    "aip-c01": {
      "scope": "涵盖基于基础模型的生成式 AI 应用设计、RAG、智能体、评估、安全性和生产运维。",
      "difficulty": 5,
      "why": "同时考虑搜索和生成质量、访问控制、延迟和推理成本。",
      "audience": "适合将生成式 AI 功能从验证阶段推进到生产环境的开发人员和架构师。",
      "path": "ai-professional-01"
    },
    "scs-c03": {
      "scope": "涵盖身份和访问管理、加密、基础设施保护、威胁检测、调查和事件响应。",
      "difficulty": 5,
      "why": "需要综合阅读多账户中的 IAM、资源和密钥策略，判断实际允许或拒绝的操作。",
      "audience": "适合负责云安全设计、审计或漏洞响应的人员。",
      "path": "security-specialty-03"
    },
    "ans-c01": {
      "scope": "涵盖 AWS 与本地环境的连接、网络设计、路由控制、运维和故障排查。",
      "difficulty": 5,
      "why": "需要从前提条件出发，分析 BGP 路由、DNS 转发方向和多个 VPC 之间的可达性。",
      "audience": "设计和运营使用 Direct Connect 和 Transit Gateway 的混合基础设施的人员。",
      "path": "advanced-networking-specialty-01"
    },
    "ai-business-strategist": {
      "scope": "涵盖 AI 投资优先级、业务价值衡量、风险管理，以及在组织中的导入和落地。",
      "difficulty": 3,
      "why": "除 AI 基础知识外，还需能够按案例比较业务成果、实施准备度和治理方案。",
      "audience": "负责决定是否引入 AI 的业务负责人、产品负责人和顾问。",
      "path": "ai-business-strategist-01"
    }
  },
