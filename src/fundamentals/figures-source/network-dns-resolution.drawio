        <mxCell id="reply-edge" style="endArrow=block;endFill=1;strokeColor=#14736F;strokeWidth=2.3;dashed=1;exitX=0.98;exitY=0;entryX=0.97;entryY=1;" edge="1" parent="1" source="authority" target="resolver">
