    {
      "blocks": [
        {
          "contentRef": "section:ttl:misconception:claim",
          "kind": "misconception",
          "label": "これは誤り",
          "text": "レコード変更直後にTTLを短くすれば、全利用者が新しい値を見る。"
        },
        {
          "contentRef": "section:ttl:misconception:correction",
          "kind": "correction",
          "label": "訂正",
          "text": "既存キャッシュは旧TTLが切れるまで残ります。切替前からTTLと待機時間を計画します。"
        }
      ],
      "estimatedSeconds": 19,
