{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "public/theme.js",
      "vite.config.ts",
      "biome.json",
      "package.json",
      "tsconfig.json",
      "vercel.json"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 105 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["src/style.css"],
      "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } }
    },
    {
      "includes": ["src/history.ts"],
      "linter": { "rules": { "suspicious": { "noDocumentCookie": "off" } } }
    }
  ]
}
