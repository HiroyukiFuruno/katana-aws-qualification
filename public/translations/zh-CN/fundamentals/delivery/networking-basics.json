    {
      "blocks": [
        {
          "contentRef": "section:http-tls:misconception:claim",
          "kind": "misconception",
          "label": "这是错误的",
          "text": "如果 HTTPS 返回 404，则 TLS 证书也已损坏。",
          "words": 13
        },
        {
          "contentRef": "section:http-tls:misconception:correction",
          "kind": "correction",
          "label": "更正",
          "text": "404 是 TLS 成功后的 HTTP 响应。证书验证和 HTTP 资源查找属于不同的失败阶段。",
          "words": 21
        }
      ],
