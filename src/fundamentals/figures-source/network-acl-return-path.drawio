        <mxCell id="alb-sg" value="ALB SG (ENI)" style="rounded=1;html=0;dashed=1;fillColor=#EEF6FF;strokeColor=#2684FF;fontSize=15;fontStyle=1;fontColor=#0747A6;" vertex="1" parent="public"><mxGeometry x="25" y="80" width="158" height="82" as="geometry" /></mxCell>
