      "blocks": [
        {
          "contentRef": "section:artifacts-promotion:paragraph:0",
          "kind": "paragraph",
          "label": "将经过验证的构件原样交付到生产环境",
          "text": "构建生成的分发文件和容器镜像称为构件。如果针对每个环境重新构建，所使用的依赖项和生成的文件可能会发生变化，因此内容可能与验证时不同。",
          "words": 46
        },
        {
          "contentRef": "section:artifacts-promotion:paragraph:1",
          "kind": "paragraph",
          "label": "将经过验证的构件原样交付到生产环境",
          "text": "使用构建编号或摘要标识构件，并在验证环境和生产环境中使用相同的构件。连接目标等环境特定的值，应在部署目标的配置中指定。",
          "words": 38
        }
      ],
      "estimatedSeconds": 25,
      "id": "fundamentals.cicd:section:artifacts-promotion:concept:1",
      "kind": "reading",
      "label": "将经过验证的构件原样交付到生产环境",
      "objectiveIds": [
