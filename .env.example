# Public values only. Never place an OAuth secret or Supabase service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring GitHub OAuth in the Supabase project.
VITE_AUTH_GITHUB_ENABLED=false
# Enable only after configuring Google OAuth in the Supabase project.
VITE_AUTH_GOOGLE_ENABLED=false
# Enable only after configuring Microsoft OAuth in the Supabase project.
VITE_AUTH_MICROSOFT_ENABLED=false
