          "kind": "scenario",
          "label": "状況",
          "text": "画像変換Lambdaが特定prefixの画像を読み、成果物を書き込む。"
        },
        {
          "contentRef": "section:least-privilege:step:0",
          "kind": "steps",
          "label": "手順 1",
          "text": "必要なGetObjectとPutObjectを列挙する。"
        },
        {
          "contentRef": "section:least-privilege:step:1",
          "kind": "steps",
          "label": "手順 2",
          "text": "対象bucketとprefixを限定する。"
        }
      ],
