    },
    {
      "blocks": [
        {
          "contentRef": "section:regions-az:scenario",
          "kind": "scenario",
          "label": "情境",
          "text": "假設同一個 AZ 中的兩個執行個體同時停止。",
          "words": 13
        },
        {
          "contentRef": "section:regions-az:step:0",
          "kind": "steps",
          "label": "步驟 1",
          "text": "區分單一執行個體故障與 AZ 故障。",
          "words": 8
        },
        {
          "contentRef": "section:regions-az:step:1",
          "kind": "steps",
          "label": "步驟 2",
          "text": "將必要的處理部署到另一個 AZ。",
          "words": 10
        }
      ],
      "estimatedSeconds": 18,
      "id": "fundamentals.cloud-concepts:section:regions-az:example:1",
      "kind": "example",
      "label": "範例",
      "objectiveIds": [
