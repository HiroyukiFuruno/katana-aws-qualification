        },
        {
          "contentRef": "section:public:step:0",
          "kind": "steps",
          "label": "步骤 1",
          "text": "在该子网的路由表中，确认目标为 0.0.0.0/0 的路由是否指向 IGW。",
          "words": 19
        },
        {
          "contentRef": "section:public:step:1",
          "kind": "steps",
          "label": "步骤 2",
          "text": "确认 EC2 实例是否具有公有 IPv4 地址或 Elastic IP。",
          "words": 13
        }
