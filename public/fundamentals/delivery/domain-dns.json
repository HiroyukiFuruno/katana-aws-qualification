      "blocks": [
        {
          "contentRef": "section:ttl:step:2",
          "kind": "steps",
          "label": "手順 3",
          "text": "切替後に複数リゾルバーから応答とアプリの状態を観測する。"
        },
        {
          "contentRef": "section:ttl:outcome",
          "kind": "outcome",
          "label": "結論",
          "text": "古い応答が残る時間を考慮して切替と監視を設計できる。"
        }
      ],
      "estimatedSeconds": 18,
      "id": "fundamentals.domain-dns:section:ttl:example:2",
      "kind": "example",
      "label": "具体例",
      "objectiveIds": [
