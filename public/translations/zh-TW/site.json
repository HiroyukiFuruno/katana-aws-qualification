  "glossary": [
    {
      "term": "ABAC",
      "expansion": "Attribute-based access control",
      "definition": "ABAC 會比對使用者和資源的屬性（例如標籤）來控管存取。可用團隊標籤作為條件，讓不同團隊共用同一套政策。",
      "category": "security",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "ACID",
      "expansion": "Atomicity, consistency, isolation, durability",
      "definition": "ACID 指資料庫交易的原子性、一致性、隔離性與持久性。多項更新可作為同一筆交易處理，避免中途失敗時只寫入部分變更。",
      "category": "database",
      "tags": [
        "data-processing"
      ]
    },
    {
      "term": "ACM",
      "expansion": "AWS Certificate Manager",
      "definition": "ACM 是 AWS 用來簽發及管理 TLS 憑證的服務。符合驗證條件時，綁定支援服務的 AWS 憑證可由 ACM 代為續約。",
      "category": "security",
      "tags": [
        "encryption"
      ]
    },
    {
      "term": "ALB",
      "expansion": "Application Load Balancer",
      "definition": "ALB 是處理 HTTP/HTTPS 流量的負載平衡器，可依主機名稱或 URL 路徑將請求轉送至不同目標。若主要處理 TCP/UDP 流量，則可評估 NLB。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "AMI",
      "expansion": "Amazon Machine Image",
      "definition": "AMI 是用來啟動 EC2 執行個體的映像檔，可包含作業系統與已安裝的軟體，方便建立設定一致的執行個體。",
      "category": "compute",
      "tags": [
        "deployment"
      ]
    },
    {
      "term": "ARN",
      "expansion": "Amazon Resource Name",
      "definition": "ARN 是識別 AWS 資源的名稱，可用於 IAM 政策中的資源指定。依服務而異，ARN 的區域或帳戶欄位可能為空。",
      "category": "security",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "ASG",
      "expansion": "Auto Scaling group",
      "definition": "Auto Scaling 群組（ASG）會集中管理 EC2 執行個體的數量與運作狀態，可設定預期數量以及最小、最大數量。",
      "category": "compute",
      "tags": [
        "availability"
      ]
    },
    {
      "term": "AZ",
      "expansion": "Availability Zone",
      "definition": "AZ（可用區）是 AWS 區域內彼此隔離的據點。若要降低單一可用區故障的影響，應讓運算資源和資料分布於多個可用區。",
      "category": "architecture",
      "tags": [
        "availability"
      ]
    },
    {
      "term": "Batch inference",
      "expansion": "",
      "definition": "批次推論是一次非同步處理多筆輸入的方式，適合不需立即取得結果的大量工作；若需即時回應，則可採用即時推論。",
      "category": "ai",
      "tags": [
        "machine-learning"
      ]
    },
    {
      "term": "BGP",
      "expansion": "Border Gateway Protocol",
      "definition": "BGP 是在不同網路之間交換可達路由的通訊協定，常用於 Direct Connect 或支援動態路由的 Site-to-Site VPN。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "Blue/green deployment",
      "expansion": "",
      "definition": "藍綠部署會讓新舊環境同時運作，確認新版本正常後再將流量切換過去。若資料變更仍與舊環境相容，回復也會較容易。",
      "category": "architecture",
      "tags": [
        "deployment"
      ]
    },
    {
      "term": "Canary deployment",
      "expansion": "",
      "definition": "金絲雀部署會先將一部分流量導向新版本，觀察錯誤率等指標，再逐步擴大部署範圍；若發生異常，可將影響限制在小範圍內。",
      "category": "architecture",
      "tags": [
        "deployment"
      ]
    },
    {
      "term": "CDC",
      "expansion": "Change data capture",
      "definition": "CDC（變更資料擷取）會擷取新增、更新、刪除等變更，並持續同步至另一個系統。資料庫遷移時，通常先載入既有資料，再追上後續變更，並在切換前確認同步延遲。",
      "category": "database",
      "tags": [
        "data-processing"
      ]
    },
    {
      "term": "CIDR",
      "expansion": "Classless Inter-Domain Routing",
      "definition": "CIDR 以網路前綴表示位址範圍，例如 10.0.0.0/16。規劃 VPC 互連時，位址範圍重疊會影響路由判斷。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "CMK",
      "expansion": "Customer master key",
      "definition": "CMK 是 AWS KMS 過去使用的名稱，現在通稱 KMS 金鑰。其中由客戶建立並管理金鑰政策的類型，稱為客戶自管金鑰（customer managed key）。",
      "category": "security",
      "tags": [
        "encryption"
      ]
    },
    {
      "term": "CORS",
      "expansion": "Cross-origin resource sharing",
      "definition": "CORS 是由伺服器透過 HTTP 標頭告知瀏覽器，哪些跨來源請求可以存取資源的機制。資源本身的身分驗證與授權仍須另外設定。",
      "category": "networking",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "CUR",
      "expansion": "AWS Cost and Usage Reports",
      "definition": "CUR（成本與用量報告）可提供 AWS 費用及用量的明細。若要依帳戶或服務分析，還要確認報告的彙總設定及是否啟用所需標籤。",
      "category": "management",
      "tags": [
        "cost"
      ]
    },
    {
      "term": "DLQ",
      "expansion": "Dead-letter queue",
      "definition": "DLQ（死信佇列）用來隔離處理或傳送失敗的訊息。設計時應明確決定哪些階段的失敗要送入 DLQ，以及重新處理前如何排除原因。",
      "category": "integration",
      "tags": [
        "event-driven"
      ]
    },
    {
      "term": "DR",
      "expansion": "Disaster recovery",
      "definition": "DR（災難復原）是災害發生時恢復服務和資料的設計與流程。需設定 RPO、RTO，並實際演練切換及切回。",
      "category": "architecture",
      "tags": [
        "disaster-recovery"
      ]
    },
    {
      "term": "DynamoDB Streams",
      "expansion": "",
      "definition": "DynamoDB Streams 會依時間順序記錄資料表項目的變更。若變更會觸發後續處理，該處理應具備冪等性，以便安全重試。",
      "category": "database",
      "tags": [
        "event-driven",
        "data-processing"
      ]
    },
    {
      "term": "EBS",
      "expansion": "Amazon Elastic Block Store",
      "definition": "EBS 是 EC2 等服務使用的區塊儲存。磁碟區隸屬於單一可用區；可透過快照在另一個可用區建立新磁碟區。",
      "category": "storage",
      "tags": [
        "data-protection"
      ]
    },
    {
      "term": "ECS",
      "expansion": "Amazon Elastic Container Service",
      "definition": "ECS 是 AWS 的容器協調服務，可管理容器執行與服務維持；容器可在 EC2 或 AWS Fargate 上執行。",
      "category": "compute",
      "tags": [
        "containers"
      ]
    },
    {
      "term": "EKS",
      "expansion": "Amazon Elastic Kubernetes Service",
      "definition": "EKS 是 AWS 代管的 Kubernetes 服務。若系統需要 Kubernetes API 或既有 Kubernetes 維運工具，EKS 是可考慮的選項。",
      "category": "compute",
      "tags": [
        "containers"
      ]
    },
    {
      "term": "ENI",
      "expansion": "Elastic network interface",
      "definition": "ENI 是 VPC 中的虛擬網路介面，隸屬於特定子網路。將次要 ENI 移至另一個 EC2 執行個體時，必須符合相同可用區等條件。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "ETL",
      "expansion": "Extract, transform, load",
      "definition": "ETL 會先擷取來源資料、進行轉換，再載入儲存目的地；ELT 則是在載入後才轉換，兩者的處理順序不同。",
      "category": "analytics",
      "tags": [
        "data-processing"
      ]
    },
    {
      "term": "Fan-out",
      "expansion": "",
      "definition": "扇出架構會將同一事件分送給多個訂閱者。若要讓各消費者獨立控制處理速度與重試，可為每個訂閱者配置個別佇列。",
      "category": "integration",
      "tags": [
        "event-driven"
      ]
    },
    {
      "term": "Guardrail",
      "expansion": "",
      "definition": "Guardrail 是讓設計與營運維持在可接受範圍內的治理措施。AWS Control Tower 現稱其為 Control，並提供預防、違規偵測及資源建立前檢查等類型。",
      "category": "management",
      "tags": [
        "governance"
      ]
    },
    {
      "term": "IAM",
      "expansion": "AWS Identity and Access Management",
      "definition": "IAM 用來控管對 AWS 資源的存取。操作是否獲准，須綜合判斷主體政策、資源政策及套用的權限上限。",
      "category": "security",
      "tags": [
        "access-control"
      ]
    },
    {
      "term": "Idempotency",
      "expansion": "",
      "definition": "冪等性表示同一個請求重複執行時，結果和副作用仍與只執行一次相同。這能讓訂單或付款流程安全地重試。",
      "category": "architecture",
      "tags": [
        "event-driven"
      ]
    },
    {
      "term": "IGW",
      "expansion": "Internet gateway",
      "definition": "IGW（網際網路閘道）讓 VPC 可與網際網路通訊。EC2 若要直接透過 IPv4 對外連線，還需要公有 IPv4 位址、路由，以及允許流量的安全設定。",
      "category": "networking",
      "tags": [
        "connectivity"
      ]
    },
    {
      "term": "IRSA",
      "expansion": "IAM roles for service accounts",
      "definition": "IRSA 可在 EKS 中將 Kubernetes 服務帳戶連結至 IAM 角色。應縮小 OIDC 信任政策的適用範圍，並只授予工作負載所需權限。",
      "category": "security",
      "tags": [
        "access-control",
        "containers"
      ]
    },
    {
      "term": "KMS",
      "expansion": "AWS Key Management Service",
      "definition": "AWS KMS 用於建立和管理加密金鑰，並控管加解密等操作。跨帳戶使用時，須檢查金鑰政策、呼叫端權限，以及目標服務的限制。",
      "category": "security",
      "tags": [
        "encryption"
      ]
    },
    {
      "term": "Least privilege",
      "expansion": "",
      "definition": "最小權限原則要求主體只取得完成工作所需的權限。應限制可執行的操作、可存取的資源及適用條件。",
