      "sectionId": "resolution",
      "objectiveId": "resolution",
      "prompt": "resolver 在查询权威 DNS 之前没有旧缓存。名称解析的下一步是什么？",
      "selectionPolarity": "correct",
      "requiredChoices": 1,
      "choices": [
        {
          "id": "C",
          "text": "从根开始沿委派链查询，继续到目标 zone 的权威 DNS",
          "explanation": "没有缓存时，resolver 会沿 DNS 层级中的委派链获取答案。"
        },
        {
          "id": "A",
          "text": "将 path 直接发送给 HTTP 服务器以确定 IP 地址",
          "explanation": "HTTP 请求发生在名称解析之后，这不是 DNS 的职责。"
        },
        {
          "id": "B",
          "text": "使用 TLS 证书生成 A record",
          "explanation": "证书验证和 DNS record 生成是不同的职责。"
        },
        {
          "id": "D",
          "text": "根据端口号推测权威 zone",
          "explanation": "端口是服务入口，不决定 DNS 委派关系。"
        }
      ],
      "correct": [
        "C"
      ],
