{
  "id": "ai-literacy",
  "title": "AI 基礎與素養",
  "objective": "能為業務問題選擇合適的 AI 方式。",
  "prerequisites": [
    {
      "slug": "cloud-concepts",
      "title": "雲端基本概念"
    }
  ],
  "sections": [
    {
      "id": "solution-choice",
      "title": "為每項課題選擇方法",
      "paragraphs": [
        "對於根據固定條件進行的折扣判定，我們選擇規則；對於需求預測，我們選擇 ML；對於查詢回覆草稿，我們選擇生成式 AI。"
      ],
      "sources": [
        {
          "label": "AIB-C01 考試指南",
          "url": "https://docs.aws.amazon.com/ja_jp/aws-certification/latest/ai-business-strategist-01/ai-business-strategist-01.pdf"
        }
      ]
    },
    {
      "id": "data-quality",
      "title": "將資料品質與業務成果連結",
      "paragraphs": [
        "如果客戶資料過時、缺漏或存在偏差，AI 的輸出也無法用於業務決策。負責人會確認使用目的與代表性。"
      ],
      "sources": [
        {
          "label": "AIB-C01 考試指南",
          "url": "https://docs.aws.amazon.com/ja_jp/aws-certification/latest/ai-business-strategist-01/ai-business-strategist-01.pdf"
        }
      ]
    },
    {
      "id": "genai-methods",
      "title": "設計生成式 AI 的限制",
      "paragraphs": [
        "定義提示的目的、依據與輸出格式。衡量權杖與內容脈絡的限制，並對最新的內部資訊使用 RAG。"
      ],
      "sources": [
        {
          "label": "AIB-C01 考試指南",
          "url": "https://docs.aws.amazon.com/ja_jp/aws-certification/latest/ai-business-strategist-01/ai-business-strategist-01.pdf"
        }
      ]
    }
  ],
  "checkpoints": [
    {
      "id": "lit-q1",
      "prompt": "業務部門主管要依照固定價目表自動產生報價。首先應選擇哪種方式？",
      "choices": [
        {
          "id": "b",
          "text": "生成式 AI",
          "explanation": "對於不需要變化的判斷，這不是首選。"
        },
        {
          "id": "c",
          "text": "強化學習",
          "explanation": "目的不是從獎勵中學習行動。"
        },
        {
          "id": "a",
          "text": "以規則為基礎的自動化",
          "explanation": "正確。結果由固定條件決定。"
        },
        {
          "id": "d",
          "text": "代理程式",
          "explanation": "不需要自主執行多個操作。"
        }
      ],
      "correct": ["a"]
    },
    {
      "id": "lit-q2",
      "prompt": "銷售負責人要使用過時的客戶屬性開始進行流失預測。首先應確認什麼？",
      "choices": [
        {
          "id": "b",
          "text": "只根據模型名稱作決定。",
          "explanation": "這無法解決資料問題。"
        },
        {
          "id": "c",
          "text": "不確認結果就發布。",
          "explanation": "這會帶來風險。"
        },
        {
          "id": "a",
          "text": "確認資料是否能代表目前的客戶。",
          "explanation": "正確。品質與代表性是作出判斷的前提。"
        },
        {
          "id": "d",
          "text": "只增加資料量。",
          "explanation": "資料的過時性與偏差仍會存在。"
        }
      ],
      "correct": ["a"]
    },
    {
      "id": "lit-q3",
      "prompt": "法務負責人希望回答能反映每週修訂的內部規章。以下哪種方法最適合？",
      "choices": [
        {
          "id": "b",
          "text": "只使用一般知識",
          "explanation": "無法保證反映最新規章。"
        },
        {
          "id": "c",
          "text": "刪除規章",
          "explanation": "這會失去依據。"
        },
        {
          "id": "d",
          "text": "延長輸出內容",
          "explanation": "這無法反映更新內容。"
        },
        {
          "id": "a",
          "text": "使用 RAG 取得現行規章",
          "explanation": "正確。這會將最新依據加入內容脈絡。"
        }
      ],
      "correct": ["a"]
    }
  ],
  "glossaryTerms": [
    "Artificial intelligence",
    "Machine learning",
    "Generative AI",
    "RAG",
    "Prompt",
    "Token",
    "Context window",
    "Data quality",
    "Model bias",
    "AI literacy"
  ]
}
