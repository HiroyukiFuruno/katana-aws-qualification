    {
      "blocks": [
        {
          "contentRef": "section:ttl:misconception:claim",
          "kind": "misconception",
          "label": "這是錯誤的",
          "text": "如果在變更記錄後立即縮短 TTL，所有使用者都會看到新值。"
        },
        {
          "contentRef": "section:ttl:misconception:correction",
          "kind": "correction",
          "label": "更正",
          "text": "現有快取會保留到舊 TTL 到期為止。在切換前規劃 TTL 和等待時間。"
        }
      ],
      "estimatedSeconds": 19,
      "id": "fundamentals.domain-dns:section:ttl:misconception:1",
      "kind": "misconception",
