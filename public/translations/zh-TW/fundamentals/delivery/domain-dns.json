    {
      "blocks": [
        {
          "contentRef": "section:ttl:takeaway:0",
          "kind": "takeaway",
          "label": "要點",
          "text": "TTL 是解析器的快取時間。"
        },
        {
          "contentRef": "section:ttl:takeaway:1",
          "kind": "takeaway",
          "label": "要點",
          "text": "切換時要以變更後舊回應仍會保留為前提。"
        },
        {
          "contentRef": "section:ttl:takeaway:2",
          "kind": "takeaway",
          "label": "要點",
          "text": "也要確認別名記錄的 TTL 如何決定。"
        }
      ],
