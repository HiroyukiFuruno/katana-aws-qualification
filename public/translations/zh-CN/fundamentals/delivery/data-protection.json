{
  "checkpoints": [
    {
      "id": "fundamentals.data-protection.checkpoint.encryption.v1",
      "sectionId": "encryption",
      "objectiveId": "encryption",
      "prompt": "HTTPS 通信已加密，但尚未确认存储在 S3 中的备份的加密设置。还应检查什么？",
      "selectionPolarity": "correct",
      "requiredChoices": 1,
      "choices": [
        {
          "id": "A",
          "text": "检查静态加密设置以及用于解密的密钥设置。",
          "explanation": "TLS 保护传输中的数据，因此需要单独检查静态数据的保护。"
        },
        {
          "id": "B",
          "text": "认为使用 HTTPS 就不需要静态加密设置。",
          "explanation": "传输中的保护并不能保证存储数据受到保护。"
        },
        {
          "id": "C",
          "text": "移除加密，只重新检查通信。",
          "explanation": "这只会削弱保护，却没有消除静态数据面临的风险。"
        },
        {
          "id": "D",
          "text": "不检查密钥的使用者，就授予所有人解密权限。",
          "explanation": "解密权限应仅授予有需要的主体。"
        }
      ],
      "correct": [
        "A"
      ],
      "source": {
        "label": "Amazon S3 加密",
        "url": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/UsingEncryption.html"
      },
      "category": "fundamentals.data-protection",
      "revision": 1,
      "title": "传输中与静态存储：保护的环节不同",
      "unitId": "fundamentals.data-protection",
      "version": "2026-11-learning"
    },
    {
      "id": "fundamentals.data-protection.checkpoint.kms.v1",
      "sectionId": "kms",
      "objectiveId": "kms",
      "prompt": "应用无法读取加密对象。排查 KMS 时，请选择两项需要检查的内容。",
      "selectionPolarity": "correct",
      "requiredChoices": 2,
      "choices": [
        {
          "id": "A",
          "text": "应用的角色是否有权使用该密钥",
          "explanation": "密钥使用者需要具备 KMS 使用权限。"
        },
        {
          "id": "B",
          "text": "密钥策略是否允许该角色使用密钥",
          "explanation": "除了 IAM policy，还需要评估 KMS key policy。"
        },
        {
          "id": "C",
          "text": "缩短密钥名称就能获得权限",
          "explanation": "更改名称不会为策略添加许可。"
        },
        {
          "id": "D",
          "text": "向所有主体授予 kms:*",
          "explanation": "授予全部权限无法解决根本原因，还会破坏最小权限原则。"
        }
      ],
      "correct": [
        "A",
        "B"
      ],
      "source": {
        "label": "AWS KMS 策略评估",
        "url": "https://docs.aws.amazon.com/kms/latest/developerguide/policy-evaluation.html"
      },
      "category": "fundamentals.data-protection",
      "revision": 1,
      "title": "KMS：密钥本身与使用密钥的权限",
      "unitId": "fundamentals.data-protection",
      "version": "2026-11-learning"
    },
    {
      "id": "fundamentals.data-protection.checkpoint.recovery.v1",
      "sectionId": "recovery",
      "objectiveId": "recovery",
      "prompt": "备份作业已成功。请选择一种适当的方法，以确认是否满足恢复目标。",
      "selectionPolarity": "correct",
      "requiredChoices": 1,
      "choices": [
        {
          "id": "B",
          "text": "实际将数据恢复到隔离的目标位置，并验证数据和所需时间。",
          "explanation": "仅成功创建备份，并不能证明数据可以恢复，也不能证明能够满足 RTO。"
        },
        {
          "id": "A",
          "text": "仅根据作业显示“成功”就判断可以恢复。",
          "explanation": "备份创建结果和恢复测试是两项不同的检查。"
        },
        {
          "id": "C",
          "text": "先删除生产数据，再首次尝试恢复。",
          "explanation": "验证时没有必要破坏生产数据。"
        },
        {
          "id": "D",
          "text": "不确定恢复目标位置或验证条件，只增加执行次数。",
          "explanation": "仅凭执行次数无法评估恢复的数据或所需时间。"
        }
      ],
      "correct": [
