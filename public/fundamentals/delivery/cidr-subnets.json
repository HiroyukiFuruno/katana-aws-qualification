          "contentRef": "section:reserved:misconception:claim",
          "kind": "misconception",
          "label": "これは誤り",
          "text": "/26には64個あるため、64台のEC2へ必ず割り当てられる。"
        },
        {
          "contentRef": "section:reserved:misconception:correction",
          "kind": "correction",
          "label": "訂正",
          "text": "AWS IPv4サブネットでは5個が予約されるため、/26で通常利用できるのは59個です。"
        }
      ],
      "estimatedSeconds": 19,
      "id": "fundamentals.cidr-subnets:section:reserved:misconception:1",
      "kind": "misconception",
      "label": "これは誤りと訂正",
      "objectiveIds": [
        "reserved"
      ],
      "sectionId": "reserved",
      "sources": [],
      "style": "misconception",
