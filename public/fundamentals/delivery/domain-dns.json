        {
          "contentRef": "section:boundary:scenario",
          "kind": "scenario",
          "label": "状況",
          "text": "DNSは正しいが、利用者がHTTPSで証明書エラーを見る。"
        },
        {
          "contentRef": "section:boundary:step:0",
          "kind": "steps",
          "label": "手順 1",
          "text": "digで名前と応答を確認する。"
        },
        {
          "contentRef": "section:boundary:step:1",
          "kind": "steps",
          "label": "手順 2",
          "text": "接続先が提示する証明書の名前と有効期限を確認する。"
        }
      ],
      "estimatedSeconds": 18,
      "id": "fundamentals.domain-dns:section:boundary:example:1",
      "kind": "example",
      "label": "具体例",
      "objectiveIds": [
