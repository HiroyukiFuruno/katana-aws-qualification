    },
    {
      "blocks": [
        {
          "contentRef": "section:diagnosis:step:2",
          "kind": "steps",
          "label": "步骤 3",
          "text": "先检查 TLS，再检查 HTTP 响应。",
          "words": 7
        },
        {
          "contentRef": "section:diagnosis:outcome",
          "kind": "outcome",
          "label": "结论",
          "text": "这样可以确定最先失败的阶段，避免不必要的应用程序修改或过于宽泛的网络授权。",
          "words": 22
        }
      ],
