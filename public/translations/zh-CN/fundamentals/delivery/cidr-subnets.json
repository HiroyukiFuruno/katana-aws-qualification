    {
      "blocks": [
        {
          "contentRef": "section:reserved:misconception:claim",
          "kind": "misconception",
          "label": "这是错误的",
          "text": "/24 中的 256 个地址都可以分配给 EC2。",
          "words": 10
        },
        {
          "contentRef": "section:reserved:misconception:correction",
          "kind": "correction",
          "label": "更正",
          "text": "AWS 会保留前 4 个地址和最后 1 个地址。",
          "words": 14
        }
      ],
