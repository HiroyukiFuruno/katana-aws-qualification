<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron">
  <diagram id="identity-role-session" name="IAM role trust and session permissions">
    <mxGraphModel grid="0" page="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="How an IAM role is used" style="text;html=0;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="8" y="8" width="304" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caller" value="Caller principal&#10;user, workload, or service" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#F4F8FD;strokeColor=#4976A5;strokeWidth=1.3;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="62" y="54" width="196" height="50" as="geometry" />
        </mxCell>
        <mxCell id="role" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;html=0;fillColor=#FFF8F6;strokeColor=#B87526;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="10" y="154" width="300" height="241" as="geometry" />
        </mxCell>
        <mxCell id="role-title" value="IAM role" style="text;html=0;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="role">
          <mxGeometry x="12" y="9" width="130" height="21" as="geometry" />
        </mxCell>
        <mxCell id="trust" value="Trust policy&#10;WHO may assume this role?" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#FFFFFF;strokeColor=#B87526;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="role">
          <mxGeometry x="18" y="48" width="264" height="49" as="geometry" />
        </mxCell>
        <mxCell id="sts" value="AWS STS issues&#10;temporary session credentials" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#FFF5E7;strokeColor=#B87526;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="role">
          <mxGeometry x="46" y="118" width="208" height="44" as="geometry" />
        </mxCell>
        <mxCell id="permissions" value="Permissions policy&#10;Allowed actions and resources" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#FFFFFF;strokeColor=#4976A5;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="role">
          <mxGeometry x="18" y="179" width="264" height="49" as="geometry" />
        </mxCell>
        <mxCell id="target" value="AWS resource&#10;e.g. an S3 object" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#ECF5E9;strokeColor=#638B52;strokeWidth=1.3;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="72" y="441" width="176" height="47" as="geometry" />
        </mxCell>
        <mxCell id="assume-label" value="AssumeRole request&#10;allowed only by trust" style="text;html=0;align=left;verticalAlign=middle;fontSize=12;fontColor=#8A4E12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="183" y="107" width="123" height="29" as="geometry" />
        </mxCell>
        <mxCell id="use-label" value="Call with session credentials" style="text;html=0;align=left;verticalAlign=middle;fontSize=12;fontColor=#234D77;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="167" y="398" width="137" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cue" value="Trust policy: who can assume the role.&#10;Permissions policy: what it can do." style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#F4F8FD;strokeColor=#4976A5;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=12;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="10" y="509" width="300" height="42" as="geometry" />
        </mxCell>
        <mxCell id="e-assume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#B87526;strokeWidth=2;" edge="1" parent="1" source="caller" target="trust">
          <mxGeometry relative="1" as="geometry" />
