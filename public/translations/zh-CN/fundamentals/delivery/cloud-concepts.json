          "contentRef": "section:regions-az:scenario",
          "kind": "scenario",
          "label": "情境",
          "text": "假设同一 AZ 中的两台实例同时停止运行。"
        },
        {
          "contentRef": "section:regions-az:step:0",
          "kind": "steps",
          "label": "步骤 1",
          "text": "区分单个实例故障和 AZ 故障。"
        },
        {
          "contentRef": "section:regions-az:step:1",
          "kind": "steps",
          "label": "步骤 2",
          "text": "将所需的处理部署到另一个 AZ。"
        }
      ],
      "estimatedSeconds": 18,
