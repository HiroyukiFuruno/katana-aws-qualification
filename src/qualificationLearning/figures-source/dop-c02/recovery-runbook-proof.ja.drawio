<mxfile host="app.diagrams.net"><diagram name="Recovery proof"><mxGraphModel background="#FFFFFF" page="1" pageWidth="400" pageHeight="260"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="証明できて初めて復旧成功" style="text;html=0;fontSize=18;fontStyle=1;fontColor=#172B4D;align=left;" vertex="1" parent="1"><mxGeometry x="16" y="10" width="368" height="24" as="geometry"/></mxCell><mxCell id="failure" value="障害" style="rounded=1;html=0;fillColor=#FFF0EF;strokeColor=#DE5851;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="55" width="112" height="34" as="geometry"/></mxCell><mxCell id="restore" value="データを復元" style="rounded=1;html=0;fillColor=#EAF4FE;strokeColor=#2684FF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="145" y="55" width="145" height="34" as="geometry"/></mxCell><mxCell id="switch" value="検証してからトラフィックを切替" style="rounded=1;html=0;fillColor=#E3FCEF;strokeColor=#36B37E;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="120" width="368" height="38" as="geometry"/></mxCell><mxCell id="proof" value="測定: RPO 時点 • RTO 経過時間" style="rounded=1;html=0;fillColor=#FFF7D6;strokeColor=#FFAB00;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="185" width="368" height="38" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=block;strokeWidth=2;strokeColor=#DE5851;" edge="1" parent="1" source="failure" target="restore"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="endArrow=block;strokeWidth=2;strokeColor=#36B37E;" edge="1" parent="1" source="restore" target="switch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="endArrow=block;strokeWidth=2;strokeColor=#FFAB00;" edge="1" parent="1" source="switch" target="proof"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
