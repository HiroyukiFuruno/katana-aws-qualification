      "blocks": [
        {
          "contentRef": "section:boundary:paragraph:0",
          "kind": "paragraph",
          "label": "区分名称解析故障与连接后的故障",
          "text": "DNS 根据名称返回连接目标。能否与返回的目标建立 TCP 连接、HTTP 是否返回预期响应，以及 TLS 证书是否与名称匹配，都是独立的检查。",
          "words": 41
        },
        {
          "contentRef": "section:boundary:paragraph:1",
          "kind": "paragraph",
          "label": "区分名称解析故障与连接后的故障",
          "text": "Route 53 运行状况检查和路由策略会影响 DNS 响应的选择，但不能保证应用程序的所有功能都正常。请明确监控目标和切换条件。",
          "words": 39
        },
        {
          "contentRef": "section:boundary:paragraph:2",
          "kind": "paragraph",
          "label": "区分名称解析故障与连接后的故障",
          "text": "将公共 DNS、私有托管区域、负载均衡器、CloudFront 和证书的所有者绘制成图，以确定故障发生在哪一层。",
          "words": 27
        }
      ],
      "estimatedSeconds": 39,
      "id": "fundamentals.domain-dns:section:boundary:concept:1",
      "kind": "reading",
      "label": "区分名称解析故障与连接后的故障",
