<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron">
  <diagram id="release-database-compatibility" name="Expand and contract for application rollback">
    <mxGraphModel grid="0" page="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="canvas" value="" style="html=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="320" height="620" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Schema changes with rollback" style="text;html=0;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="8" y="8" width="304" height="27" as="geometry" />
        </mxCell>
        <mxCell id="old-app" value="Old application&#10;rollback target" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#E7F0FA;strokeColor=#4976A5;strokeWidth=1.3;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="18" y="56" width="124" height="52" as="geometry" />
        </mxCell>
        <mxCell id="new-app" value="New application&#10;compatible code" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#ECF5E9;strokeColor=#638B52;strokeWidth=1.3;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="178" y="56" width="124" height="52" as="geometry" />
        </mxCell>
        <mxCell id="access-cue" value="Both releases read and write the shared database" style="text;html=0;align=center;verticalAlign=middle;fontSize=13;fontColor=#234D77;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="18" y="119" width="284" height="18" as="geometry" />
        </mxCell>
        <mxCell id="db-boundary" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;html=0;fillColor=#F8FAFD;strokeColor=#4976A5;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry x="10" y="153" width="300" height="384" as="geometry" />
        </mxCell>
        <mxCell id="db-title" value="Shared order database boundary" style="text;html=0;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="db-boundary">
          <mxGeometry x="12" y="8" width="270" height="20" as="geometry" />
        </mxCell>
        <mxCell id="expand" value="1  EXPAND&#10;Add nullable column: delivery_class" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#E7F0FA;strokeColor=#4976A5;strokeWidth=1.3;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="db-boundary">
          <mxGeometry x="18" y="46" width="264" height="51" as="geometry" />
        </mxCell>
        <mxCell id="compatible" value="2  COMPATIBLE&#10;Old app ignores new column&#10;New app keeps old field usable" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#ECF5E9;strokeColor=#638B52;strokeWidth=1.3;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="db-boundary">
          <mxGeometry x="18" y="115" width="264" height="65" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="3  MIGRATE AND VERIFY&#10;Backfill order data&#10;Verify migrated values" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#FFF5E7;strokeColor=#B87526;strokeWidth=1.3;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="db-boundary">
          <mxGeometry x="18" y="198" width="264" height="65" as="geometry" />
        </mxCell>
        <mxCell id="contract" value="4  CONTRACT (later)&#10;Remove old column&#10;only after old app is retired" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#F3F5F7;strokeColor=#667788;strokeWidth=1.3;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="db-boundary">
          <mxGeometry x="18" y="281" width="264" height="65" as="geometry" />
        </mxCell>
        <mxCell id="cue" value="Application rollback returns to old code.&#10;It does not undo shared database data." style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#FFFFFF;strokeColor=#B87526;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=13;fontColor=#4B351B;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="10" y="555" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="e-compat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#638B52;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="expand" target="compatible">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#B87526;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="compatible" target="verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-contract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#667788;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="verify" target="contract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>