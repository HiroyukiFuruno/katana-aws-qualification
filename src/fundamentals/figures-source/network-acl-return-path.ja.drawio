  <diagram id="network-acl-return-path" name="ALB EC2 return traffic">
    <mxGraphModel dx="1600" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="600" pageHeight="850" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="ALB から EC2: 戻り通信の制御" style="text;html=0;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="560" height="32" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="バックエンドのリクエストとレスポンスを追う。" style="text;html=0;align=left;verticalAlign=middle;fontSize=16;fontColor=#42526E;" vertex="1" parent="1"><mxGeometry x="20" y="43" width="560" height="24" as="geometry" /></mxCell>
        <mxCell id="main" value="VPC 内の1本のバックエンド接続" style="swimlane;html=0;rounded=1;startSize=38;fillColor=#F7FAFC;strokeColor=#4C9AFF;fontSize=18;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="18" y="78" width="564" height="500" as="geometry" /></mxCell>
        <mxCell id="vpc" value="VPC" style="swimlane;html=0;rounded=1;startSize=27;fillColor=#FFFFFF;strokeColor=#36B37E;fontSize=18;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="main"><mxGeometry x="16" y="46" width="532" height="420" as="geometry" /></mxCell>
        <mxCell id="az" value="AZ A" style="swimlane;html=0;rounded=1;startSize=25;fillColor=#F6FFFB;strokeColor=#36B37E;dashed=1;fontSize=18;fontStyle=1;fontColor=#172B4D;align=left;spacingLeft=14;" vertex="1" parent="vpc"><mxGeometry x="16" y="36" width="500" height="366" as="geometry" /></mxCell>
        <mxCell id="az-note" value="ALB は2つの AZ に配置&#xa;（1つを表示）" style="text;html=0;align=center;verticalAlign=middle;fontSize=18;fontColor=#42526E;" vertex="1" parent="az"><mxGeometry x="280" y="2" width="200" height="24" as="geometry" /></mxCell>
        <mxCell id="public" value="パブリック ALB サブネット" style="swimlane;html=0;rounded=1;startSize=27;fillColor=#FFFDF5;strokeColor=#FFAB00;fontSize=18;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="az"><mxGeometry x="16" y="42" width="208" height="292" as="geometry" /></mxCell>
        <mxCell id="private" value="プライベート EC2 サブネット" style="swimlane;html=0;rounded=1;startSize=27;fillColor=#F6F4FF;strokeColor=#6554C0;fontSize=18;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="az"><mxGeometry x="276" y="42" width="208" height="292" as="geometry" /></mxCell>
        <mxCell id="public-nacl" value="ACL" style="rounded=1;html=0;fillColor=#FFF7D6;strokeColor=#FFAB00;fontSize=17;fontStyle=1;fontColor=#594300;" vertex="1" parent="public"><mxGeometry x="14" y="36" width="180" height="25" as="geometry" /></mxCell>
        <mxCell id="private-nacl" value="ACL" style="rounded=1;html=0;fillColor=#FFF7D6;strokeColor=#FFAB00;fontSize=17;fontStyle=1;fontColor=#594300;" vertex="1" parent="private"><mxGeometry x="14" y="36" width="180" height="25" as="geometry" /></mxCell>
        <mxCell id="alb-sg" value="ALB SG" style="rounded=1;html=0;dashed=1;verticalAlign=top;spacingTop=4;fillColor=#EEF6FF;strokeColor=#2684FF;fontSize=18;fontStyle=1;fontColor=#0747A6;" vertex="1" parent="public"><mxGeometry x="25" y="80" width="158" height="82" as="geometry" /></mxCell>
        <mxCell id="alb" value="ALB ノード" style="rounded=1;html=0;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=18;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="alb-sg"><mxGeometry x="20" y="34" width="118" height="31" as="geometry" /></mxCell>
        <mxCell id="ec2-sg" value="EC2 SG" style="rounded=1;html=0;dashed=1;verticalAlign=top;spacingTop=4;fillColor=#EEF6FF;strokeColor=#2684FF;fontSize=18;fontStyle=1;fontColor=#0747A6;" vertex="1" parent="private"><mxGeometry x="25" y="80" width="158" height="82" as="geometry" /></mxCell>
        <mxCell id="ec2" value="EC2" style="rounded=1;html=0;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=18;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="ec2-sg"><mxGeometry x="20" y="34" width="118" height="31" as="geometry" /></mxCell>
        <mxCell id="request-label" value="リクエスト: ALB 49152 → EC2 443" style="text;html=0;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0052CC;" vertex="1" parent="az"><mxGeometry x="155" y="98" width="190" height="24" as="geometry" /></mxCell>
        <mxCell id="request" style="endArrow=block;endFill=1;strokeWidth=3;strokeColor=#0052CC;" edge="1" parent="az" source="alb-sg" target="ec2-sg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="199" y="163" /><mxPoint x="301" y="163" /></Array></mxGeometry></mxCell>
        <mxCell id="response" style="endArrow=block;endFill=1;strokeWidth=3;strokeColor=#6554C0;" edge="1" parent="az" source="ec2-sg" target="alb-sg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="301" y="217" /><mxPoint x="199" y="217" /></Array></mxGeometry></mxCell>
        <mxCell id="response-label" value="レスポンス: EC2 443 → ALB 49152" style="text;html=0;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#6554C0;" vertex="1" parent="az"><mxGeometry x="155" y="235" width="190" height="24" as="geometry" /></mxCell>
        <mxCell id="public-rules" value="ACL 送信: TCP 443&#10;ACL 受信: TCP 49152" style="rounded=1;html=0;fillColor=#FFFFFF;strokeColor=#8993A4;fontSize=17;fontColor=#172B4D;" vertex="1" parent="public"><mxGeometry x="14" y="222" width="180" height="51" as="geometry" /></mxCell>
        <mxCell id="private-rules" value="ACL 受信: TCP 443&#10;ACL 送信: TCP 49152" style="rounded=1;html=0;fillColor=#FFFFFF;strokeColor=#8993A4;fontSize=17;fontColor=#172B4D;" vertex="1" parent="private"><mxGeometry x="14" y="222" width="180" height="51" as="geometry" /></mxCell>
        <mxCell id="route-note" value="ローカル VPC ルートを前提。通信制御だけを示す。" style="text;html=0;align=center;verticalAlign=middle;fontSize=18;fontColor=#42526E;" vertex="1" parent="vpc"><mxGeometry x="35" y="374" width="462" height="24" as="geometry" /></mxCell>
        <mxCell id="compare" value="戻り経路をどう判断するか" style="swimlane;html=0;rounded=1;startSize=38;fillColor=#F7FAFC;strokeColor=#4C9AFF;fontSize=18;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="18" y="596" width="564" height="280" as="geometry" /></mxCell>
        <mxCell id="compare-sg" value="セキュリティグループ（ENI）&#10;&#10;ステートフル&#10;許可: ALB SG → EC2 SG&#xa;TCP 443&#10;&#10;戻り: 確立済み通信&#10;49152 は不要" style="rounded=1;html=0;align=left;spacingLeft=16;verticalAlign=top;spacingTop=12;fillColor=#EEF6FF;strokeColor=#2684FF;fontSize=17;fontColor=#172B4D;" vertex="1" parent="compare"><mxGeometry x="18" y="48" width="248" height="200" as="geometry" /></mxCell>
        <mxCell id="compare-nacl" value="ACL（サブネット）&#10;&#10;ステートレス&#10;要求: ALB 送信 / EC2 受信&#xa;TCP 443&#10;&#10;戻り: EC2 → ALB&#xa;TCP 49152&#10;両方向を許可" style="rounded=1;html=0;align=left;spacingLeft=16;verticalAlign=top;spacingTop=12;fillColor=#FFF7D6;strokeColor=#FFAB00;fontSize=17;fontColor=#172B4D;" vertex="1" parent="compare"><mxGeometry x="298" y="48" width="248" height="200" as="geometry" /></mxCell>
        <mxCell id="footer" value="例: 49152。可変時は必要なエフェメラルポート範囲を許可。" style="text;html=0;align=center;verticalAlign=middle;fontSize=17;fontColor=#42526E;" vertex="1" parent="1"><mxGeometry x="20" y="881" width="560" height="24" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
