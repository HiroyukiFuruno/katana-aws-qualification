      "id": "fundamentals.cicd.checkpoint.continuous-integration.v1",
      "sectionId": "continuous-integration",
      "objectiveId": "cicd-1",
      "prompt": "小さなcommitごとに同じbuildとtestを実行する目的として適切なものはどれですか。",
      "selectionPolarity": "correct",
      "requiredChoices": 1,
      "choices": [
        {
          "id": "B",
          "text": "変更と失敗の距離を短くし、修正箇所を絞る",
          "explanation": "頻繁な自動検査は統合時点の差分を小さくし、原因追跡を容易にする。"
        },
        {
          "id": "A",
          "text": "失敗を次のreleaseまで隠す",
          "explanation": "CIは失敗を早期に見つけるための仕組みである。"
        },
        {
          "id": "C",
          "text": "testを省略してbuildだけを速くする",
          "explanation": "CIの目的は統合品質の早期確認であり、検査省略ではない。"
        },
        {
          "id": "D",
          "text": "commitをまとめてから一度だけ手動検査する",
          "explanation": "大きな差分を後で検査すると失敗原因が分かりにくくなる。"
        }
      ],
      "correct": [
        "B"
      ],
