    {
      "id": "fundamentals.domain-dns.checkpoint.ttl.v1",
      "sectionId": "ttl",
      "objectiveId": "ttl",
      "prompt": "DNS 記錄的 TTL 為 300 秒。變更後不久，部分使用者仍連線到舊 IP，以下哪項解釋最恰當？",
      "selectionPolarity": "correct",
      "requiredChoices": 1,
      "choices": [
        {
          "id": "A",
          "text": "在 TTL 剩餘時間內，解析器可以繼續使用快取的回答。",
          "explanation": "TTL 表示快取可使用的期間，因此變更生效需要等待一段時間。"
        },
        {
          "id": "B",
          "text": "TTL 是 HTTP 伺服器的處理時間，因此不會影響 DNS 傳播。",
          "explanation": "TTL 是 DNS 快取的保留期間，並非 HTTP 處理時間。"
        },
        {
          "id": "C",
          "text": "變更 TTL 就會立即清除所有現有快取。",
          "explanation": "新的 TTL 設定不會立即清除已經散佈的快取。"
        },
        {
          "id": "D",
          "text": "如果 IP 是舊的，就一定是權威 DNS 回傳了錯誤答案。",
          "explanation": "解析器快取也可能造成舊答案。"
        }
      ],
      "correct": [
        "A"
      ],
      "source": {
        "label": "Route 53 DNS 最佳實務",
        "url": "https://docs.aws.amazon.com/Route53/latest/DeveloperGuide/best-practices-dns.html"
      },
      "category": "fundamentals.domain-dns",
      "revision": 1,
      "title": "TTL：快取資訊持續使用的時間",
      "unitId": "fundamentals.domain-dns",
      "version": "2026-11-learning"
    },
