{
  "name": "katana-aws-qualification",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "auth:integration": "bun scripts/run-auth-integration.ts",
    "data:integration": "bun scripts/run-data-integration.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/render-routes.ts && node scripts/check-account-build.ts && node scripts/check-landing-build.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "i18n:check": "node scripts/check-locales.ts",
    "content:check": "node scripts/check-questions.ts",
    "fundamentals:check": "bun scripts/check-fundamentals.ts",
    "research:aws": "bun scripts/collect-aws-research.ts",
    "duplicates:check": "jscpd src scripts --format typescript,tsx --cross-formats typescript,tsx --min-lines 10 --min-tokens 70 --similarity=0.90 --min-nodes 55 --fail-on-empty --exit-code 1",
    "architecture:check": "node scripts/check-architecture.ts",
    "check": "bun run lint && bun run format:check && bun run i18n:check && bun run duplicates:check && bun run architecture:check && bun run content:check && bun run fundamentals:check && bun test && bun run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/auth-js": "2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@swc/core": "1.16.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "18.8.0",
    "jscpd": "5.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@supabase/auth-js@2.119.2": "patches/@supabase%2Fauth-js@2.119.2.patch"
  }
}
