{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "src/**",
      "supabase/functions/**",
      "scripts/**",
      "test/**",
      "playwright.config.ts",
      "public/theme.js",
      "vite.config.ts",
      ".dependency-cruiser.cjs",
      "biome.json",
      "package.json",
      "tsconfig.json",
      "vercel.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 105
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.ts", "**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 150 }
            }
          }
        }
      }
    },
    {
      "includes": ["src/style.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["src/history.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      "includes": ["vercel.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
