<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="network-dns-resolution" name="DNS resolution">
    <mxGraphModel background="#FFFFFF" dx="400" dy="650" grid="1" gridSize="10" page="1" pageWidth="400" pageHeight="650">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="canvas" value="" style="html=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="0" y="0" width="400" height="542" />
        </mxCell>
        <mxCell id="boundary" value="" style="rounded=1;html=0;fillColor=#F2F7FC;strokeColor=#87A8CB;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="179" width="360" height="174" />
        </mxCell>
        <mxCell id="boundary-title" value="Recursive DNS" style="text;html=0;align=center;fontSize=17;fontColor=#24354D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="37" y="186" width="142" height="27" />
        </mxCell>
        <mxCell id="title" value="How DNS answers a lookup" style="text;html=0;align=center;fontSize=25;fontStyle=1;fontColor=#142336;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="18" y="10" width="364" height="39" />
        </mxCell>
        <mxCell id="client" value="DNS client" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#FFFFFF;strokeColor=#687E95;fontSize=19;fontStyle=1;fontColor=#142336;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="113" y="66" width="174" height="45" />
        </mxCell>
        <mxCell id="resolver" value="Resolver" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#EAF3FD;strokeColor=#4776AB;fontSize=19;fontStyle=1;fontColor=#142336;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="219" width="200" height="47" />
        </mxCell>
        <mxCell id="cache" value="Cache" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#EAF6EA;strokeColor=#68906B;fontSize=19;fontStyle=1;fontColor=#142336;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="296" width="180" height="37" />
        </mxCell>
        <mxCell id="authority" value="Authoritative DNS&#10;(e.g. Route 53)" style="rounded=1;whiteSpace=nowrap;html=0;fillColor=#FFF6E9;strokeColor=#AE712C;fontSize=19;fontStyle=1;fontColor=#142336;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="104" y="435" width="192" height="61" />
