    {
      "blocks": [
        {
          "contentRef": "section:regions-az:paragraph:0",
          "kind": "paragraph",
          "label": "使用 Region 與 AZ 區分故障範圍",
          "text": "Region 是放置資源的地理單位。AZ 是單一 Region 內彼此隔離的位置，放置在同一個 AZ 中的資源可能共用相同的故障網域。",
          "words": 41
        },
        {
          "contentRef": "section:regions-az:paragraph:1",
          "kind": "paragraph",
          "label": "使用 Region 與 AZ 區分故障範圍",
          "text": "在同一個 AZ 內增加執行個體數量可以因應單一執行個體故障，但無法將整個 AZ 的故障網域分開。將資源分散到不同的 AZ 可區分故障網域。",
          "words": 38
        },
        {
          "contentRef": "section:regions-az:paragraph:2",
          "kind": "paragraph",
          "label": "使用 Region 與 AZ 區分故障範圍",
          "text": "即使在主控台中切換 Region，現有資源也不會自動移動或複製。複製到其他 Region 需要依服務進行設定。",
          "words": 31
        }
      ],
      "estimatedSeconds": 35,
      "id": "fundamentals.cloud-concepts:section:regions-az:concept:1",
      "kind": "reading",
      "label": "使用 Region 與 AZ 區分故障範圍",
      "objectiveIds": [
        "cloud-3"
      ],
      "sectionId": "regions-az",
      "sources": [],
      "style": "normal",
