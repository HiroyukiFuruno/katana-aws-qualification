      "blocks": [
        {
          "contentRef": "section:least-privilege:paragraph:0",
          "kind": "paragraph",
          "label": "最小権限と短命な認証情報",
          "text": "最小権限とは、作業に必要な操作だけを、対象のリソースと実行条件、期間を絞って許可する原則です。"
        },
        {
          "contentRef": "section:least-privilege:paragraph:1",
          "kind": "paragraph",
          "label": "最小権限と短命な認証情報",
          "text": "実行roleのcredentialは一時的に発行し、長期アクセスキーをソースコードや共有設定へ置きません。実際の利用を確認して権限を縮小・更新します。"
        }
      ],
      "estimatedSeconds": 21,
      "id": "fundamentals.identity-access:section:least-privilege:concept:1",
      "kind": "reading",
      "label": "最小権限と短命な認証情報",
