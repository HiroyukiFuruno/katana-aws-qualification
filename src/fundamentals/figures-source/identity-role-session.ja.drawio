<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron">
  <diagram id="identity-role-session" name="IAM role trust and session permissions">
    <mxGraphModel grid="0" page="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="IAM ロールの使われ方" style="text;html=0;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="8" y="8" width="304" height="28" as="geometry" />
        </mxCell>
        <mxCell id="caller" value="呼び出し元&#10;ユーザー / 処理 / サービス" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#F4F8FD;strokeColor=#4976A5;strokeWidth=1.3;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="62" y="54" width="196" height="50" as="geometry" />
        </mxCell>
        <mxCell id="role" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;html=0;fillColor=#FFF8F6;strokeColor=#B87526;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="10" y="154" width="300" height="241" as="geometry" />
        </mxCell>
        <mxCell id="role-title" value="IAM ロール" style="text;html=0;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="role">
          <mxGeometry x="12" y="9" width="130" height="21" as="geometry" />
        </mxCell>
        <mxCell id="trust" value="信頼ポリシー&#10;誰がこのロールを引き受けられるか" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#FFFFFF;strokeColor=#B87526;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="role">
          <mxGeometry x="18" y="48" width="264" height="49" as="geometry" />
        </mxCell>
        <mxCell id="sts" value="AWS STS が発行&#10;一時的なセッション認証情報" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#FFF5E7;strokeColor=#B87526;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="role">
          <mxGeometry x="46" y="118" width="208" height="44" as="geometry" />
        </mxCell>
        <mxCell id="permissions" value="アクセス許可ポリシー&#10;許可するアクションとリソース" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#FFFFFF;strokeColor=#4976A5;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="role">
          <mxGeometry x="18" y="179" width="264" height="49" as="geometry" />
        </mxCell>
        <mxCell id="target" value="AWS リソース&#10;例: S3 オブジェクト" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#ECF5E9;strokeColor=#638B52;strokeWidth=1.3;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="72" y="441" width="176" height="47" as="geometry" />
        </mxCell>
        <mxCell id="assume-label" value="AssumeRole リクエスト&#10;信頼ポリシーでのみ許可" style="text;html=0;align=left;verticalAlign=middle;fontSize=12;fontColor=#8A4E12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="183" y="107" width="123" height="29" as="geometry" />
        </mxCell>
        <mxCell id="use-label" value="セッション認証情報で呼び出す" style="text;html=0;align=left;verticalAlign=middle;fontSize=12;fontColor=#234D77;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="167" y="398" width="137" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cue" value="信頼ポリシー: 誰がロールを引き受けられるか。&#10;アクセス許可ポリシー: 何ができるか。" style="rounded=1;arcSize=6;absoluteArcSize=1;html=0;fillColor=#F4F8FD;strokeColor=#4976A5;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=12;fontColor=#142336;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="10" y="509" width="300" height="42" as="geometry" />
        </mxCell>
        <mxCell id="e-assume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#B87526;strokeWidth=2;" edge="1" parent="1" source="caller" target="trust">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-issue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#B87526;strokeWidth=2;" edge="1" parent="1" source="trust" target="sts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-use" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4976A5;strokeWidth=2;" edge="1" parent="1" source="permissions" target="target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>