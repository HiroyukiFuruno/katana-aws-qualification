    },
    {
      "blocks": [
        {
          "contentRef": "section:reserved:takeaway:0",
          "kind": "takeaway",
          "label": "要点",
          "text": "総アドレス数と利用可能数は異なります。"
        },
        {
          "contentRef": "section:reserved:takeaway:1",
          "kind": "takeaway",
          "label": "要点",
          "text": "予約済みIPアドレスと増加余地を計画に含めます。"
        }
      ],
      "estimatedSeconds": 16,
      "id": "fundamentals.cidr-subnets:section:reserved:takeaway:1",
      "kind": "takeaway",
      "label": "要点",
