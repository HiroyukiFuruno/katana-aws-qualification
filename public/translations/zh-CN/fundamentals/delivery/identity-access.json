      "sectionId": "authn-authz",
      "objectiveId": "authn-authz",
      "prompt": "运维人员登录 AWS 后，只有特定的 S3 操作返回 AccessDenied。请选择一项首先要确认的内容。",
      "selectionPolarity": "correct",
      "requiredChoices": 1,
      "choices": [
        {
          "id": "C",
          "text": "确认调用方主体、操作、目标资源，以及适用于这些对象的策略。",
          "explanation": "成功认证后的操作拒绝需要从授权方面进行排查。"
        },
        {
          "id": "A",
          "text": "反复更改密码。",
          "explanation": "这没有调查成功认证后的拒绝原因。"
        },
        {
          "id": "B",
          "text": "仅缩短 DNS TTL。",
          "explanation": "DNS 不会改变 IAM 的权限评估。"
        }
      ],
      "correct": [
        "C"
      ],
      "source": {
        "label": "IAM 策略评估逻辑",
        "url": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_evaluation-logic.html"
