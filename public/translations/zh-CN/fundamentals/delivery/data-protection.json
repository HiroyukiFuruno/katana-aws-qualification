      "id": "fundamentals.data-protection.checkpoint.secrets.v1",
      "sectionId": "secrets",
      "objectiveId": "secrets",
      "prompt": "在将 DB password 传递给应用的设计中，请选择 2 个能够减少泄露面的选项。",
      "selectionPolarity": "correct",
      "requiredChoices": 2,
      "choices": [
        {
          "id": "B",
          "text": "不要将 password 直接写入代码，而是从托管的 secret 中获取。",
          "explanation": "将值与源代码分离，可以减少代码泄露时的暴露。"
        },
        {
          "id": "C",
          "text": "将读取 secret 的 role 限定为仅供需要它的应用使用。",
          "explanation": "限制获取者有助于实现最小权限。"
        },
        {
          "id": "A",
          "text": "为了排查故障，将 password 输出到日志中。",
          "explanation": "日志的可见范围往往更广，因此应避免输出秘密值。"
        },
        {
          "id": "D",
          "text": "将同一个 secret 复制到所有开发者的环境中。",
          "explanation": "副本和可查看者都会增加，从而扩大暴露面。"
        }
      ],
      "correct": [
        "B",
        "C"
      ],
      "source": {
        "label": "Secrets Manager 数据保护",
        "url": "https://docs.aws.amazon.com/secretsmanager/latest/userguide/data-protection.html"
