      "why": "需要同時考量檢索與生成品質、存取控制、延遲和推論成本。",
      "audience": "適合負責將生成式 AI 功能從驗證階段推進至正式營運的開發者與架構師。",
      "path": "ai-professional-01"
    },
    "scs-c03": {
      "scope": "涵蓋身分與存取管理、加密、基礎架構防護、威脅偵測、調查及事件應變。",
      "difficulty": 5,
      "why": "需要綜合判讀多個帳戶的 IAM、資源與金鑰政策，判斷實際會允許或拒絕哪些操作。",
      "audience": "適合負責雲端安全架構、稽核或弱點處理的人。",
      "path": "security-specialty-03"
    },
    "ans-c01": {
      "scope": "涵蓋 AWS 與地端環境連線、網路設計、路由控制、營運及疑難排解。",
      "difficulty": 5,
      "why": "需要根據前提條件追查 BGP 路由、DNS 轉送方向，以及多個 VPC 之間的連通性。",
      "audience": "適合設計與維運使用 Direct Connect 或 Transit Gateway 的混合式基礎架構者。",
      "path": "advanced-networking-specialty-01"
    },
    "ai-business-strategist": {
      "scope": "涵蓋 AI 投資排序、商業價值衡量、風險管理，以及在組織內導入並持續推動 AI。",
      "difficulty": 3,
      "why": "除了 AI 基礎知識，也需要依個別情境比較商業成果、導入準備度與治理方式。",
      "audience": "適合負責 AI 導入決策的事業主管、產品負責人與顧問。",
      "path": "ai-business-strategist-01"
    }
  },
