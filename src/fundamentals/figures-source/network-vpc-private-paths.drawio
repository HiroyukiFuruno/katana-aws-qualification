<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="network-vpc-private-paths" name="Private VPC paths">
    <mxGraphModel background="#FFFFFF" dx="400" dy="720" grid="1" gridSize="10" page="1" pageWidth="400" pageHeight="720">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Private EC2: two destination routes" style="text;html=0;fontSize=28;fontStyle=1;fontColor=#172B4D;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="360" height="36" as="geometry" />
        </mxCell>
        <mxCell id="vpc" value="VPC 10.0.0.0/16" style="swimlane;html=0;rounded=1;startSize=40;fillColor=#F7FAFC;strokeColor=#4C9AFF;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="360" height="402" as="geometry" />
        </mxCell>
        <mxCell id="subnet" value="Private subnet" style="swimlane;html=0;rounded=1;startSize=36;fillColor=#F6FFFB;strokeColor=#36B37E;fontSize=26;fontStyle=1;" vertex="1" parent="vpc">
          <mxGeometry x="18" y="60" width="324" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ec2" value="App EC2" style="rounded=1;html=0;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=26;fontStyle=1;" vertex="1" parent="subnet">
          <mxGeometry x="22" y="58" width="120" height="58" as="geometry" />
        </mxCell>
        <mxCell id="service" value="VPC&#10;service" style="rounded=1;html=0;fillColor=#FFFFFF;strokeColor=#5E6C84;fontSize=26;fontStyle=1;" vertex="1" parent="subnet">
          <mxGeometry x="190" y="43" width="110" height="88" as="geometry" />
        </mxCell>
        <mxCell id="endpoint" value="S3 Gateway&#10;Endpoint" style="rounded=1;html=0;fillColor=#FFF7D6;strokeColor=#FFAB00;fontSize=26;fontStyle=1;" vertex="1" parent="vpc">
          <mxGeometry x="65" y="270" width="230" height="88" as="geometry" />
        </mxCell>
        <mxCell id="rt" value="Private subnet route table&#10;VPC CIDR → local&#10;S3 prefix list → gateway endpoint" style="rounded=1;html=0;fillColor=#EAF4FE;strokeColor=#2684FF;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="24" y="651" width="352" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Amazon S3&#10;same Region" style="rounded=1;html=0;fillColor=#E3FCEF;strokeColor=#36B37E;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="537" width="220" height="88" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="startArrow=block;endArrow=block;strokeColor=#0052CC;strokeWidth=4;" edge="1" parent="subnet" source="ec2" target="service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="startArrow=block;endArrow=block;strokeColor=#0052CC;strokeWidth=4;" edge="1" parent="1" source="ec2" target="endpoint">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="45" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" style="startArrow=block;endArrow=block;strokeColor=#0052CC;strokeWidth=4;" edge="1" parent="1" source="endpoint" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>