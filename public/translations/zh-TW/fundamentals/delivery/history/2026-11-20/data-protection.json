    {
      "id": "fundamentals.data-protection.checkpoint.encryption.v1",
      "sectionId": "encryption",
      "objectiveId": "encryption",
      "prompt": "HTTPS 通訊已加密，但尚未確認儲存在 S3 中的備份加密設定。還應檢查什麼？",
      "selectionPolarity": "correct",
      "requiredChoices": 1,
      "choices": [
        {
          "id": "A",
          "text": "檢查靜態加密設定，以及用於解密的金鑰設定。",
          "explanation": "TLS 保護傳輸中的資料，因此必須另外檢查靜態資料的保護。"
        },
        {
          "id": "B",
          "text": "認為使用 HTTPS 就不需要靜態加密設定。",
          "explanation": "傳輸中的保護並不能保證儲存的資料受到保護。"
        },
        {
          "id": "C",
          "text": "移除加密，只重新檢查通訊。",
          "explanation": "這只會削弱保護，卻沒有消除靜態資料面臨的風險。"
        },
        {
          "id": "D",
          "text": "不檢查金鑰的使用者，就授予所有人解密權限。",
          "explanation": "解密權限應限於有需要的主體。"
        }
      ],
      "correct": [
        "A"
      ],
      "source": {
        "label": "Amazon S3 加密",
        "url": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/UsingEncryption.html"
      },
      "category": "fundamentals.data-protection",
      "revision": 1,
      "title": "傳輸中與靜態儲存：保護的環節不同",
      "unitId": "fundamentals.data-protection",
      "version": "2026-11-learning"
    },
