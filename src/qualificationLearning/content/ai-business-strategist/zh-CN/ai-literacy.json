{
  "id": "ai-literacy",
  "title": "AI 基础与素养",
  "objective": "能够为业务问题选择合适的 AI 方式。",
  "prerequisites": [
    {
      "slug": "cloud-concepts",
      "title": "云的基本概念"
    }
  ],
  "sections": [
    {
      "id": "solution-choice",
      "title": "为每项课题选择方法",
      "paragraphs": [
        "对于基于固定条件的折扣判定，我们选择规则；对于需求预测，我们选择 ML；对于咨询回复草稿，我们选择生成式 AI。"
      ],
      "sources": [
        {
          "label": "AIB-C01 考试指南",
          "url": "https://docs.aws.amazon.com/ja_jp/aws-certification/latest/ai-business-strategist-01/ai-business-strategist-01.pdf"
        }
      ]
    },
    {
      "id": "data-quality",
      "title": "将数据质量与业务成果相结合",
      "paragraphs": [
        "如果客户数据过时、缺失或存在偏差，AI 的输出也无法用于业务决策。负责人会确认使用目的和代表性。"
      ],
      "sources": [
        {
          "label": "AIB-C01 考试指南",
          "url": "https://docs.aws.amazon.com/ja_jp/aws-certification/latest/ai-business-strategist-01/ai-business-strategist-01.pdf"
        }
      ]
    },
    {
      "id": "genai-methods",
      "title": "设计生成式 AI 的约束",
      "paragraphs": [
        "确定提示的目的、依据和输出格式。测量令牌和上下文的限制，并对最新的内部信息使用 RAG。"
      ],
      "sources": [
        {
          "label": "AIB-C01 考试指南",
          "url": "https://docs.aws.amazon.com/ja_jp/aws-certification/latest/ai-business-strategist-01/ai-business-strategist-01.pdf"
        }
      ]
    }
  ],
  "checkpoints": [
    {
      "id": "lit-q1",
      "prompt": "销售部门负责人要按照固定价目表自动生成报价。首先应选择哪种方式？",
      "choices": [
        {
          "id": "b",
          "text": "生成式 AI",
          "explanation": "对于不需要变化的判断，这不是首选。"
        },
        {
          "id": "c",
          "text": "强化学习",
          "explanation": "目标不是从奖励中学习行动。"
        },
        {
          "id": "a",
          "text": "基于规则的自动化",
          "explanation": "正确。结果由固定条件决定。"
        },
        {
          "id": "d",
          "text": "智能体",
          "explanation": "不需要自主执行多个操作。"
        }
      ],
      "correct": ["a"]
    },
    {
      "id": "lit-q2",
      "prompt": "销售负责人要使用过时的客户属性开始预测客户流失。首先应确认什么？",
      "choices": [
        {
          "id": "b",
          "text": "仅根据模型名称作出决定。",
          "explanation": "这无法解决数据问题。"
        },
        {
          "id": "c",
          "text": "不确认结果就发布。",
          "explanation": "这会带来风险。"
        },
        {
          "id": "a",
          "text": "确认数据是否代表当前客户。",
          "explanation": "正确。数据质量和代表性是作出判断的前提。"
        },
        {
          "id": "d",
          "text": "只增加数据量。",
          "explanation": "数据的过时性和偏差仍会存在。"
        }
      ],
      "correct": ["a"]
    },
    {
      "id": "lit-q3",
      "prompt": "法务负责人希望回答能够反映每周修订的内部规章制度。以下哪种方法最合适？",
      "choices": [
        {
          "id": "b",
          "text": "仅使用通用知识",
          "explanation": "无法保证反映最新规章制度。"
        },
        {
          "id": "c",
          "text": "删除规章制度",
          "explanation": "这样会失去依据。"
        },
        {
          "id": "d",
          "text": "延长输出内容",
          "explanation": "这样无法反映更新内容。"
        },
        {
          "id": "a",
          "text": "使用 RAG 获取现行规章制度",
          "explanation": "正确。这样可以将最新依据加入上下文。"
        }
      ],
      "correct": ["a"]
    }
  ],
  "glossaryTerms": [
    "Artificial intelligence",
    "Machine learning",
    "Generative AI",
    "RAG",
    "Prompt",
    "Token",
    "Context window",
    "Data quality",
    "Model bias",
    "AI literacy"
  ]
}
