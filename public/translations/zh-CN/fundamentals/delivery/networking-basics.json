    {
      "id": "fundamentals.networking-basics.checkpoint.ip-port.v1",
      "sectionId": "ip-port",
      "objectiveId": "ip-port",
      "prompt": "连接同一 IP 地址的 SSH 成功，但只有 HTTPS 无法连接。首先应分别检查什么？",
      "selectionPolarity": "correct",
      "requiredChoices": 1,
      "choices": [
        {
          "id": "C",
          "text": "HTTPS 使用的端口，以及该服务是否正在该端口上监听",
          "explanation": "如果 IP 地址可达，但只有特定服务失败，应分别检查端口和服务入口。"
        },
        {
          "id": "A",
          "text": "把 IP 地址当作端口号",
          "explanation": "IP 地址标识对端主机；端口标识该主机上的服务入口，两者作用不同。"
        },
        {
          "id": "B",
          "text": "仅凭 SSH 成功就判断 HTTPS 的 HTTP 请求处理也成功",
          "explanation": "不同端口上的服务能够正常工作，并不能保证 HTTPS 也能正常工作。"
        },
        {
          "id": "D",
          "text": "开放所有端口来掩盖原因",
          "explanation": "开放所有端口无助于排查问题，反而会降低安全性。"
        }
      ],
      "correct": [
        "C"
      ],
