          "label": "步驟 1",
          "text": "確認目前的 TTL，以及變更前可用的等待時間。",
          "words": 11
        },
        {
          "contentRef": "section:ttl:step:1",
          "kind": "steps",
          "label": "步驟 2",
          "text": "事先縮短 TTL，並等待舊 TTL 到期。",
          "words": 12
        }
      ],
      "estimatedSeconds": 18,
      "id": "fundamentals.domain-dns:section:ttl:example:1",
      "kind": "example",
      "label": "範例",
