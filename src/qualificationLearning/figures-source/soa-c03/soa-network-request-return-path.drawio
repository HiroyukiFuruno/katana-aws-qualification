        <mxCell id="nacl" value="NACL: stateless subnet&#10;check return ephemeral ports" style="rounded=1;html=0;fillColor=#FDEBEC;strokeColor=#DE5851;fontSize=14;fontStyle=1;" vertex="1" parent="1">
