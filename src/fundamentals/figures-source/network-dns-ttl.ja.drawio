<mxfile host="app.diagrams.net"><diagram id="network-dns-ttl" name="DNS TTL"><mxGraphModel background="#FFFFFF" dx="400" dy="680" grid="1" gridSize="10" page="1" pageWidth="400" pageHeight="680"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="DNS TTL: 2つの応答が共存" style="text;html=0;fontSize=18;fontStyle=1;fontColor=#172B4D;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="360" height="36" as="geometry"/></mxCell>
<mxCell id="a" value="09:00&#10;リゾルバー A が&#10;api.example = 198.51.100.11 を&#10;TTL 300 秒でキャッシュ" style="rounded=1;html=0;fillColor=#EAF4FE;strokeColor=#2684FF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="90" width="350" height="116" as="geometry"/></mxCell>
<mxCell id="change" value="09:02&#10;権威 DNS が api.example を&#10;198.51.100.22 に変更" style="rounded=1;html=0;fillColor=#FFF7D6;strokeColor=#FFAB00;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="246" width="350" height="92" as="geometry"/></mxCell>
<mxCell id="split" value="09:03&#10;リゾルバー A はキャッシュ済み .11 を返す&#10;リゾルバー B は .22 を取得" style="rounded=1;html=0;fillColor=#FFEBE6;strokeColor=#DE350B;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="378" width="350" height="92" as="geometry"/></mxCell>
<mxCell id="expiry" value="09:05&#10;リゾルバー A の TTL が期限切れ&#10;次の問い合わせで .22 を取得" style="rounded=1;html=0;fillColor=#E3FCEF;strokeColor=#36B37E;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="510" width="350" height="92" as="geometry"/></mxCell>
